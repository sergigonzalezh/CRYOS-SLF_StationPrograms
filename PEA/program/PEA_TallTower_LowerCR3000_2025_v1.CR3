' ---------------------------------------------------------
' CR3000 Series
' Program: PEA2025 - UpperLogger CR1000X
' Author and History:
' 15.01.2024 - Hendrik Huwald, EPFL: Original program for PEA2024
' 08.04.2024 - Sergi González-Herrero, SLF: Adaptation for PEA2025 with CR3000 and CSAT+LICOR
' 20.11.2024 - Sergi González-Herrero, SLF: Changes with the final instruments for PEA2025 with CR1000X
'
' Program, measures:
'  1x GPS (with A300 module)
'  1x CSAT3 3D sonic anemometer at 10Hz (16m)
'  1x LICOR at 10Hz (16m)
'  2x Wind 05108-45 Young wind monitor (WS,WD) (16m, 10m)
'  2x TH-P Atmos14 (16m, 10m)
'  1x Rad SN500SS (16m)
'  2x SnowDrift FlowCapt FC4 (4m, 11m)
'
' Sensor Wiring: wire color (function) -> port
' color code: red(rd), green(gn), blue(bl), yellow(ye), white(wh), black(bk), brown(bn),
' color code: grey(gy), orange(or), violet(vt), pink(pk), bare(ba), cl=clear
'
' Power consumption:
'     0mA at 12V =  0.000W  SI-111
'    65mA at 12V =  0.780W  GPS Receiver
'    50mA at 12V =  0.600W  CR6 estimated; 67mA @20Hz, 3mA @1Hz scan
'
'Options for Tall Tower
' _16m = refers to the height of the instruments
' _L = refers to the logger (U=Upper; L=Lower)
'
' ---------------------------------------------------------

'SequentialMode
PipeLineMode

'============================================================
' DECLARATIONS ==============================================
'============================================================

' Sampling, output and time stamp--------------------------

' Declare local time offset relative to UTC time for GPS
Const LOCAL_TIME_OFFSET = 0    ' Local time offset relative to UTC time

' Scan frequencies 
Const SFREQ1 = 100    ' [mSec] Fast scan interval, main program (100mSec = 10Hz)
Const SFREQ2 = 10    ' [Sec]  Slow scan interval, slow sequence

' Output frequencies
Const OFREQ1 = 100     ' [mSec] fast output
Const OFREQ2 = 60     ' [Sec]  slow output

' Default SDM clock speed for CSAT3 in [uSec]
Const SDM_PER = 150

' CSAT3 azimuth (if known)
Const CSAT3_azimuth = 90

'Adresses and Ports
Const CSAT3_address_16m = 2	'S/N: 1261 (#01)
Const LIC75_address_16m = 13 'Licor #2, SDM: 12
Const ATMOS14_address_16m = 0	'S/N: 20355
Const VP3_address_10m = 1	'VP-4S/N: 062401071
Const SN500SS_address_16m = 4 'S/N: 2509
Const FC4_address_11m = 7	'S/N: FC23A019
Const FC4_address_4m = 8	'S/N: FC23A044
Const GPSPort = 5 'Com port where GPS is connected

'Constants
Const Young_mult = 0.1666 'S/N: 145744 & 145745 Multiplier depend on the model 05103/05106 = 0.0980, 05108(Alpine)=0.1666 and 05305=0.1024

'============================================================
' TABLE MANAGEMENT ==========================================
'============================================================

'---------------------------------------------------------
'Power and Logger ----------------------------------------
Public BattV_L
Units BattV_L = V

' Data logger wiring panel temperature
Public PTemp_L
Units PTemp_L = degC

'---------------------------------------------------------
'Public clockmod -----------------------------------------
Public LoggerTime_L(9) As Long
Alias LoggerTime_L(2) = month_L
Alias LoggerTime_L(4) = hour_L
Alias LoggerTime_L(5) = minute_L
Alias LoggerTime_L(9) = doy_L

'---------------------------------------------------------
' ATMOS14-------------------------------------------------
Public ATMOS14_16m(4)
Alias ATMOS14_16m(1) = VP_16m
Alias ATMOS14_16m(2) = Temp_16m
Alias ATMOS14_16m(3) = RH_16m
Alias ATMOS14_16m(4) = AP_16m

Units Temp_16m = Deg_C
Units VP_16m = kPa
Units AP_16m = kPa

'---------------------------------------------------------
' ATMOS14 (VP3)-------------------------------------------
Public VP3_10m(3)
Alias VP3_10m(1) = VP_10m
Alias VP3_10m(2) = Temp_10m
Alias VP3_10m(3) = RH_10m
'Alias VP3_10m(4) = AP_10m

Units Temp_10m = Deg_C
Units VP_10m = kPa
'Units AP_10m = kPa

'---------------------------------------------------------
' YOUNG Wind Monitor 1------------------------------------
Public WS_16m
Public WD_16m

Units WS_16m = m/s
Units WD_16m = deg

'---------------------------------------------------------
' YOUNG Wind Monitor 2------------------------------------
Public WS_10m
Public WD_10m

Units WS_10m = m/s
Units WD_10m = deg

'---------------------------------------------------------
' FlowCap FC4 1-------------------------------------------
Public FC_11m(8)
Alias FC_11m(1) = FluxMin_11m
Alias FC_11m(2) = FluxMean_11m
Alias FC_11m(3) = FluxMax_11m
Alias FC_11m(4) = FluxStd_11m
Alias FC_11m(5) = FluxSum_11m
Alias FC_11m(6) = WindMin_11m
Alias FC_11m(7) = WindMean_11m
Alias FC_11m(8) = WindMax_11m

Units FluxMin_11m = g/m2/s
Units FluxMean_11m = g/m2/s
Units FluxMax_11m = g/m2/s
Units FluxStd_11m = g/m2/s
Units FluxSum_11m = g/m2/s
Units WindMin_11m = km/h
Units WindMean_11m = km/h
Units WindMax_11m = km/h

Public FC_Flux_11m
Public FC_Wind_11m

Units FC_Flux_11m = g/m2
Units FC_Wind_11m = km/h

'---------------------------------------------------------
' FlowCap FC4 2-------------------------------------------
Public FC_4m(8)
Alias FC_4m(1) = FluxMin_4m
Alias FC_4m(2) = FluxMean_4m
Alias FC_4m(3) = FluxMax_4m
Alias FC_4m(4) = FluxStd_4m
Alias FC_4m(5) = FluxSum_4m
Alias FC_4m(6) = WindMin_4m
Alias FC_4m(7) = WindMean_4m
Alias FC_4m(8) = WindMax_4m

Units FluxMin_4m = g/m2/s
Units FluxMean_4m = g/m2/s
Units FluxMax_4m = g/m2/s
Units FluxStd_4m = g/m2/s
Units FluxSum_4m = g/m2/s
Units WindMin_4m = km/h
Units WindMean_4m = km/h
Units WindMax_4m = km/h

Public FC_Flux_4m
Public FC_Wind_4m

Units FC_Flux_4m = g/m2
Units FC_Wind_4m = km/h


'---------------------------------------------------------
' SN500SS-------------------------------------------------
Public Net_16m(4)
Alias Net_16m(1) = Incoming_SW_16m
Alias Net_16m(2) = Outgoing_SW_16m
Alias Net_16m(3) = Incoming_LW_16m
Alias Net_16m(4) = Outgoing_LW_16m

Units Net_16m = W/m2

'---------------------------------------------------------
' CSAT3---------------------------------------------------

' CSAT3 execution parameter
Const CSAT_OPT = INT(1000/SFREQ1)  'Denominator in [mSec]

Public wind_16m(5)
Alias wind_16m(1) = Ux_16m
Alias wind_16m(2) = Uy_16m
Alias wind_16m(3) = Uz_16m
Alias wind_16m(4) = Ts_16m
Alias wind_16m(5) = diag_csat_16m

Units wind_16m = m/s
Units Ts_16m = degC
Units diag_csat_16m = none

' CSAT3 warning flags:
' 1) delta temperature, 2) poor signal lock,
' 3) amplitude high, or 4) amplitude low.
Public diag_bits_16m(4) As Boolean
Units diag_bits_16m = samples

Alias diag_bits_16m(1) = delT_f_16m
Alias diag_bits_16m(2) = sigl_f_16m
Alias diag_bits_16m(3) = amph_f_16m
Alias diag_bits_16m(4) = ampl_f_16m

' Diagnostic variables
Dim disable_flag_on_16m(2) As Boolean
Dim n_16m
Units n_16m = samples

' Working variables
Dim diag_csat_work_16m As Long

'Wind directions and speed.
Dim wnd_out_16m(8)
'Alias wnd_out_16m(1) = wnd_spd_16m - in compass coordinate system, same As CSAT3.
'Alias wnd_out_16m(2) = rslt_wnd_spd_16m - in compass coordinate system, same As CSAT3.
Alias wnd_out_16m(3) = wnd_dir_compass_16m
'Alias wnd_out_16m(4) = std_wnd_dir_16m - in compass coordinate system, same As CSAT3.
Alias wnd_out_16m(5) = wnd_spd_16m
Alias wnd_out_16m(6) = rslt_wnd_spd_16m
Alias wnd_out_16m(7) = wnd_dir_csat3_16m
Alias wnd_out_16m(8) = std_wnd_dir_16m

Units wnd_dir_compass_16m = degrees
Units wnd_spd_16m = m/s
Units rslt_wnd_spd_16m = m/s
Units wnd_dir_csat3_16m = degrees
Units std_wnd_dir_16m = degrees

'Working variables.
Dim wind_east_16m 'East wind in compass coordinate system.
Dim wind_north_16m 'North wind in compass coordinate system. 

'---------------------------------------------------------
' LI-7500A -----------------------------------------------
  
Public LIC75_16m(4) 'Licor output mode set equal to 6 !!!

Alias LIC75_16m(1) = LI_CO2m_16m  'CO2 [mmol/m3]
Alias LIC75_16m(2) = LI_H2Om_16m  'H2O [mmol/m3]
Alias LIC75_16m(3) = LI_Pres_16m  'Pressure [kPa]
Alias LIC75_16m(4) = LI_diag_16m  'Diagnostic value

Units LI_CO2m_16m = mmol/m3
Units LI_H2Om_16m = mmol/m3
Units LI_Pres_16m = kPa
Units LI_diag_16m = unitless  

Public diag_LI_bits_16m(4) As Boolean
Units diag_LI_bits_16m = samples
Alias diag_LI_bits_16m(1) = li_chopper_16m
Alias diag_LI_bits_16m(2) = li_detector_16m
Alias diag_LI_bits_16m(3) = li_pll_16m
Alias diag_LI_bits_16m(4) = li_sync_16m

Dim diag_licor_work_16m As Long

'---------------------------------------------------------
'GPS using the Serial Instruction ------------------------ 
'GPS16X-HVS at Campbell Scientific Factory Defaults
'Public GGAstring As String * 500
'Public RMCstring As String * 500
Dim NMEASent(2) As String * 100

Public GPSData(15)

Alias GPSData(1)=Latitude_A
Alias GPSData(2)=Latitude_B
Alias GPSData(3)=Longitude_A
Alias GPSData(4)=Longitude_B
Alias GPSData(5)=Speed
Alias GPSData(6)=Course
Alias GPSData(7)=MagVar
Alias GPSData(8)=FixQual
Alias GPSData(9)=NumSats
Alias GPSData(10)=Altitude
Alias GPSData(11)=PPS
Alias GPSData(12)=SecSinceGPRMC
Alias GPSData(13)=GPSReady
Alias GPSData(14)=MaxClockChange
Alias GPSData(15)=NumClockChange

Units Latitude_A=degrees
Units Latitude_B=minutes
Units Longitude_A=degrees
Units Longitude_B=minutes
Units Speed=knots
Units Course=degrees
Units MagVar=degrees
Units FixQual=code
Units NumSats=count
Units Altitude=meters
Units PPS=microseconds
Units SecSinceGPRMC=seconds
Units GPSReady=count
Units MaxClockChange=milliseconds
Units NumClockChange=count


'============================================================
' DEFINE DATA TABLES ========================================
'============================================================

Const TableName_Tower1_FastData = "PEAL_Fast"
Const FileName_Tower1_FastData = "CRD:" & TableName_Tower1_FastData & "_"
Public LastWrittenFile_Tower1_FastData As String * 40
ReadOnly LastWrittenFile_Tower1_FastData

'Const TableName_Tower1_WindData = "PEAU_Wind"
'Const FileName_Tower1_WindData = "CRD:" & TableName_Tower1_WindData & "_"
'Public LastWrittenFile_Tower1_WindData As String * 40
'ReadOnly LastWrittenFile_Tower1_WindData

Const TableName_Tower1_SlowData = "PEAL_Slow"
Const FileName_Tower1_SlowData = "CRD:" & TableName_Tower1_SlowData & "_"
Public LastWrittenFile_Tower1_SlowData As String * 40
ReadOnly LastWrittenFile_Tower1_SlowData


Const FileInterval_FastData = 24     '[h], create four files per day 'with a data rate of 10Hz, it produces 432'000 records per file
Const FileInterval_SlowData = 0     '[h], create one file per day 'with 60s data period, it would produce 17'280 records per file
Const FileInterval_WindData = 24     '[h], create one file per day 'with 60s data period, it would produce 17'280 records per file
Const FileTimeOnInt = 0              'new file at midnight


'---------------------------------------------------------
' FAST Table ---------------------------------------------
DataTable(FAST,True,-1)
  DataInterval(0,OFREQ1,mSec,0)
  TableFile(FileName_Tower1_FastData,64,-1,FileTimeOnInt,FileInterval_FastData,hr,0,LastWrittenFile_Tower1_FastData)
  Sample(4,Ux_16m,IEEE4)        ' Ux_26m, Uy_26m, Uz_26m, Ts_26m
  Sample(4,LI_CO2m_16m,IEEE4)	' CO2_26m, H2O_26m, Pressure_26m, diag_Uicor_26m
  Sample(1,diag_csat_16m,UINT2) ' CSAT diagnostic word. Store as unsigned integer
EndTable

'---------------------------------------------------------
' SLOW Table ---------------------------------------------
DataTable(SLOW,True,-1)
  DataInterval(0,OFREQ2,Sec,0)
  TableFile(FileName_Tower1_SlowData,8,-1,FileTimeOnInt,FileInterval_SlowData,hr,0,LastWrittenFile_Tower1_SlowData)  
	'Sample(1,NMEASent(1),String)
	'Sample(1,NMEASent(2),String)
	'Sample(1,Latitude_A,FP2)
	'Sample(1,Latitude_B,FP2)
	'Sample(1,Altitude,FP2)
	'Sample(1,PPS,FP2)
	'Sample(1,SecSinceGPRMC,FP2)
	'Sample(1,MaxClockChange,FP2)
	'Sample(1,NumClockChange,FP2)

  'LOGGER-----------------------------------------
  Minimum(1,BattV_L,FP2,False,False)
  Average(1,PTemp_L,FP2,False)

  'ATMOS14----------------------------------------
  Average(1,VP_16m,FP2,False)
  Average(1,Temp_16m,FP2,False)
  Average(1,RH_16m,FP2,False)
  Average(1,AP_16m,FP2,False)
  
  'VP3--------------------------------------------
  Average(1,VP_10m,FP2,False)
  Average(1,Temp_10m,FP2,False)
  Average(1,RH_10m,FP2,False)
  'Average(1,AP_10m,FP2,False)
  
  'YOUNG Wind Monitor 1---------------------------
  Average(1,WS_16m,FP2,False)        ' mean over OFREQ2 interval (here 1min)
  Maximum(1,WS_16m,FP2,False,False)  ' max. over a 1sec interval (wind gust)
  StdDev(1,WS_16m,FP2,False)         ' Std. over OFREQ2 interval (here 1min)
  Sample(1,WD_16m,FP2)
  
  'YOUNG Wind Monitor 2---------------------------
  Average(1,WS_10m,FP2,False)        ' mean over OFREQ2 interval (here 1min)
  Maximum(1,WS_10m,FP2,False,False)  ' max. over a 1sec interval (wind gust)
  StdDev(1,WS_10m,FP2,False)         ' Std. over OFREQ2 interval (here 1min)
  Sample(1,WD_10m,FP2)
  
  'FLOWCAPT FC4 1---------------------------------
  Sample(1,FluxMin_11m,FP2)
  Sample(1,FluxMean_11m,FP2)
  Sample(1,FluxMax_11m,FP2)
  Sample(1,FluxStd_11m,FP2)
  Sample(1,FluxSum_11m,FP2)
  Sample(1,WindMin_11m,FP2)
  Sample(1,WindMean_11m,FP2)
  Sample(1,WindMax_11m,FP2)
  
  Sample(1,FC_Flux_11m,FP2)
  Sample(1,FC_Wind_11m,FP2)
  
  'FLOWCAPT FC4 2---------------------------------
  Sample(1,FluxMin_4m,FP2)
  Sample(1,FluxMean_4m,FP2)
  Sample(1,FluxMax_4m,FP2)
  Sample(1,FluxStd_4m,FP2)
  Sample(1,FluxSum_4m,FP2)
  Sample(1,WindMin_4m,FP2)
  Sample(1,WindMean_4m,FP2)
  Sample(1,WindMax_4m,FP2)
  
  Sample(1,FC_Flux_4m,FP2)
  Sample(1,FC_Wind_4m,FP2)
  
  'SN500SS----------------------------------------
  Average(1,Incoming_SW_16m,IEEE4,False)
  Average(1,Outgoing_SW_16m,IEEE4,False)
  Average(1,Incoming_LW_16m,IEEE4,False)
  Average(1,Outgoing_LW_16m,IEEE4,False)

  'CSAT3 & LI-7500A-------------------------------
  Average(4,Ux_16m,IEEE4,False)
  StdDev(1,Ux_16m,IEEE4,False)
  Average(4,LI_CO2m_16m,IEEE4,0)
  StdDev (4,LI_CO2m_16m,IEEE4,0)
  
  Sample (1,wnd_dir_compass_16m,IEEE4)
  Sample (1,wnd_dir_csat3_16m,IEEE4)
  Sample (1,wnd_spd_16m,IEEE4)
  Sample (1,rslt_wnd_spd_16m,IEEE4)
  Sample (1,std_wnd_dir_16m,IEEE4)

  Totalize(1,n_16m,IEEE4,NOT(disable_flag_on_16m(1) OR disable_flag_on_16m(2)))
  FieldNames("csat_warnings_16m")
  Totalize(1,n_16m,IEEE4,NOT(delT_f_16m) OR NOT disable_flag_on_16m(2))
  FieldNames("delT_f_Tot_16m")
  Totalize(1,n_16m,IEEE4,NOT(sigl_f_16m) OR NOT disable_flag_on_16m(2))
  FieldNames("sigl_f_Tot_16m")
  Totalize(1,n_16m,IEEE4,NOT(amph_f_16m) OR NOT disable_flag_on_16m(2))
  FieldNames("amph_f_Tot_16m")
  Totalize(1,n_16m,IEEE4,NOT(ampl_f_16m) OR NOT disable_flag_on_16m(2))
  FieldNames("ampl_f_Tot_16m")
  
  Totalize(1,n_16m,IEEE4,li_chopper_16m)
  FieldNames("li_chopper_16m")
  Totalize(1,n_16m,IEEE4,li_detector_16m)
  FieldNames("li_detector_16m")
  Totalize(1,n_16m,IEEE4,li_pll_16m)
  FieldNames("li_pll_16m")
  Totalize(1,n_16m,IEEE4,li_sync_16m)
  FieldNames("li_sync_16m")
  
EndTable


'*** Working Data Tables ***
'Compute the wind direction This data is output every OUTPUT_INTERVAL minutes.
'DataTable (wnd_vec,TRUE,1)
'  DataInterval (0,OFREQ2,Min,1)
'  'Compute wind direction from CSAT3 data.
'  WindVector (1,wind_east_16m,wind_north_16m,IEEE4,disable_flag_on_16m(1),0,1,2)
'  WindVector (1,Uy_16m,Ux_16m,IEEE4,disable_flag_on_16m(1),0,1,2)
'EndTable 


'==========================================================
' MEASUREMENTS ============================================
'==========================================================
' Main Program
BeginProg

	'Set all CSAT3 variables to NaN.
	Move(Ux_16m,5,NaN,1)

	'Set the SDM clock speed.
	SDMSpeed(SDM_PER)

	n_16m = 0

	'Main Scan+++++++++++++++++++++++++++++++++++++++++++++++
	Scan(SFREQ1,mSec,10,0)
	  
		SDMTrigger()

		'***Measure CSAT3 and LI7500-------------------------
		
		'Get data from CSAT3, 98: Get wind & sonic temperature data after a group trigger 
		' CSAT_OPT: 10Hz execution parameter
		CSAT3(Ux_16m,1,CSAT3_address_16m,98,CSAT_OPT)
		'Get data from LI7500
		CS7500(LI_CO2m_16m,1,LIC75_address_16m,6)

		'CSAT3 processing------------------------------------
		'Define 61502 as NaN
		If (diag_csat_16m = NaN) Then 
		(diag_csat_16m = 61502)
		Ux_16m = NaN
		Uy_16m = NaN
		Uz_16m = NaN
		Ts_16m = NaN
		EndIf  
		
		'Break up the 4 CSAT3 warning flags in 4 separate bits
		diag_csat_work_16m = diag_csat_16m
		delT_f_16m = diag_csat_work_16m AND &h8000
		sigl_f_16m = diag_csat_work_16m AND &h4000
		amph_f_16m = diag_csat_work_16m AND &h2000
		ampl_f_16m = diag_csat_work_16m AND &h1000

		'Turn on the intermediate processing disable flag when any CSAT3 warning flag is
		'high, including the special cases NaN (61502), a Lost Trigger (61440), No Data
		'(61503), an SDM error (61441), or wrong CSAT3 embedded code (61442).
		disable_flag_on_16m(1) = diag_csat_work_16m AND &hf000
		'Turn on only when CSAT3 diagnostic warning flags are set.
		disable_flag_on_16m(2) = (disable_flag_on_16m(1) AND NOT (Ts_16m=NaN))

		'Save the four most significant bits of the CSAT3 diagnostics, except for the
		'special cases NaN (61502), a Lost Trigger (61440), No Data (61503), an SDM
		'error (61441), or wrong CSAT3 embedded code (61442).
		If (diag_csat_work_16m<&hf000) Then 
		  diag_csat_16m = INT(diag_csat_work_16m/&h1000)
		EndIf

		'Licor diag -----------------------------------------------
		diag_licor_work_16m = LI_diag_16m
		li_chopper_16m = diag_licor_work_16m AND &h80
		li_detector_16m = diag_licor_work_16m AND &h40
		li_pll_16m = diag_licor_work_16m AND &h20
		li_sync_16m = diag_licor_work_16m AND &h10

		' Call data tables and store Fast Data-----------------
		CallTable FAST
		
		'*** Measure the YOUNG Wind Monitor-------------------------------
		'--- rd(pulse)=P1, gn=H1, bl=VX1, bk/gy/wh(GD)=G, cl=G | Multiplier depend on the model 05103/05106 = 0.0980, 05108=0.1666 and 05305=0.1024
		'Measure wind speed as a mean of the last second (1000ms) 
		PulseCount(WS_16m,1,1,1,1,Young_mult,0)
		'Measure wind direction
		'BrHalf(WD_16m,1,mV5000,1,VX1,1,2500,True,20000,60,355,0)
		'If WD_16m>=360 OR WD_16m<0 Then WD_16m=0
		
		'*** Measure the YOUNG Wind Monitor-------------------------------
		'--- rd(pulse)=P1, gn=H1, bl=VX1, bk/gy/wh(GD)=G, cl=G | Multiplier depend on the model 05103/05106 = 0.0980, 05108=0.1666 and 05305=0.1024
		'Measure wind speed as a mean of the last second (1000ms) 
		PulseCount(WS_10m,1,2,1,1,Young_mult,0)
		'Measure wind direction
		'BrHalf(WD_10m,1,mV5000,2,VX2,1,2500,True,20000,60,355,0)
		'If WD_10m>=360 OR WD_10m<0 Then WD_10m=0

		CallTable SLOW
		'PulseCount instruction not allowed in SlowSequence
		
	NextScan 
  
  
	'++++++++++++++++++++++++++++++++++++++++++++++++++++++++
	SlowSequence

	Scan (SFREQ2,Sec,5,0)
	  
    '*** Measure the GPS using the Serial instruction-----------------
		'--- rd=12V, wh(RX)=RS-232, gr(TX)=RS-232, bk/ye/bl=G
		'GPS(GPSData(),-ComC5,0,100,NMEASent())
		GPS(GPSData(),-COM3,0*3600,500,NMEASent())

		'Get logger time
		RealTime(LoggerTime_L)

		'*** Measure the Datalogger Battery Voltage-----------------------
		Battery(BattV_L)

		'*** Measure the Datalogger Wiring Panel Temperature--------------
		PanelTemp(PTemp_L,60)
		
		'*** Measure the ATMOS14 variables--------------------------------
		'--- br(energy)=5V, or(data)=C7, ba(GD)=G
		'Query sensor for 4 SDI-12 outputs.  Default address for all Decagon Digital sensors is 0. 
		SDI12Recorder(ATMOS14_16m(),7,ATMOS14_address_16m,"C!",1.0,0,-1)
		
		'*** Measure the VP3 variables------------------------------------
		'--- wh(energy)=5V, rd(data)=C7, ba(GD)=G
		'Query sensor for 4 SDI-12 outputs.  Default address for all Decagon Digital sensors is 0. 
		SDI12Recorder(VP3_10m(),7,VP3_address_10m,"C!",1.0,0,-1)
		
		'*** Measure the YOUNG Wind Monitor-------------------------------
		'--- rd(pulse)=P1, gn=H1, bl=VX1, bk/gy/wh(GD)=G, cl=G | Multiplier depend on the model 05103/05106 = 0.0980, 05108=0.1666 and 05305=0.1024
		'Measure wind speed as a mean of the last second (1000ms) 
		'PulseCount(WS_16m,1,1,1,1,Young_mult,0)
		'Measure wind direction
		BrHalf(WD_16m,1,mV5000,1,VX1,1,2500,True,20000,60,355,0)
		If WD_16m>=360 OR WD_16m<0 Then WD_16m=0
		
		'*** Measure the YOUNG Wind Monitor-------------------------------
		'--- rd(pulse)=P1, gn=H1, bl=VX1, bk/gy/wh(GD)=G, cl=G | Multiplier depend on the model 05103/05106 = 0.0980, 05108=0.1666 and 05305=0.1024
		'Measure wind speed as a mean of the last second (1000ms) 
		'PulseCount(WS_10m,1,2,1,1,Young_mult,0)
		'Measure wind direction
		BrHalf(WD_10m,1,mV5000,3,VX2,1,2500,True,20000,60,355,0)
		If WD_10m>=360 OR WD_10m<0 Then WD_10m=0
		
		'*** Measure the FC4 Snowdrift 2----------------------------------
		'--- wh(energy)=12V, bl(data)=C7, bk(GD)=G
		SDI12Recorder(FC_11m(),7,FC4_address_11m,"M!",1.0,0,-1)
		'VoltSe(FC_Flux_11m,1,mV5000,5,False,0,_50Hz,0.05,0)
		'VoltSe(FC_Wind_11m,1,mV5000,6,False,0,_50Hz,0.05,0)
		
		'*** Measure the FC4 Snowdrift 1----------------------------------
		'--- wh(energy)=12V, bl(data)=C7, bk(GD)=G
		SDI12Recorder(FC_4m(),7,FC4_address_4m,"M!",1.0,0,-1)
	  'VoltSe(FC_Flux_4m,1,mV5000,5,False,0,_50Hz,0.05,0)
		'VoltSe(FC_Wind_4m,1,mV5000,6,False,0,_50Hz,0.05,0)

		'*** Measure the SN500SS net radiation----------------------------
		'--- rd(energy)=12V, wh(data)=C7, bk/cl(GD)=G
		SDI12Recorder(Net_16m(),7,SN500SS_address_16m,"MC!",1.0,0,-1)

	CallTable SLOW
  
	NextScan

	EndSequence

EndProg

