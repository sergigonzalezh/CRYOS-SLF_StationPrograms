' ---------------------------------------------------------
' CR3000 Series
' Program: PEA2025 - UpperLogger CR1000X
' Author and History:
' 15.01.2024 - Hendrik Huwald, EPFL: Original program for PEA2024
' 08.04.2024 - Sergi González-Herrero, SLF: Adaptation for PEA2025 with CR3000 and CSAT+LICOR
' 19.11.2024 - Sergi González-Herrero, SLF: Changes with the final instruments for PEA2025 with CR1000X
'
' Program, measures:
'  1x GPS
'  1x CSAT3 3D sonic anemometer at 10Hz
'  1x LICOR at 10Hz
'  1x Wind 05108-45 Young wind monitor (WS,WD)
'  1x TH-P Atmos14
'  1x Rad SN500SS
'
' Sensor Wiring: wire color (function) -> port
' color code: red(rd), green(gn), blue(bl), yellow(ye), white(wh), black(bk), brown(bn),
' color code: grey(gy), orange(or), violet(vt), pink(pk), bare(ba), cl=clear
'
' Power consumption:
'     0mA at 12V =  0.000W  SI-111
'    65mA at 12V =  0.780W  GPS Receiver
'    50mA at 12V =  0.600W  CR6 estimated; 67mA @20Hz, 3mA @1Hz scan
'
'Options for Tall Tower
' _26m = refers to the height of the instruments
' _U = refers to the logger (U=Upper; L=Lower)
'
' ---------------------------------------------------------

'SequentialMode
PipeLineMode

'============================================================
' DECLARATIONS ==============================================
'============================================================

' Sampling, output and time stamp--------------------------
'SetSetting("Baudrate(COMC1)",115200)

' Declare local time offset relative to UTC time for GPS
Const LOCAL_TIME_OFFSET = 0    ' Local time offset relative to UTC time

' Scan frequencies 
Const SFREQ1 = 100    ' [mSec] Fast scan interval, main program (100mSec = 10Hz)
Const SFREQ2 = 10    ' [Sec]  Slow scan interval, slow sequence

' Output frequencies
Const OFREQ1 = 100     ' [mSec] fast output
Const OFREQ2 = 60     ' [Sec]  slow output

' Default SDM clock speed for CSAT3 in [uSec]
Const SDM_PER = 100

' CSAT3 azimuth (if known)
Const CSAT3_azimuth = 90

'Adresses and Ports
Const CSAT3_address_26m = 2	'CSAT #10, SDM:3
Const LIC75_address_26m = 11 'Licor #1, SDM: 11
Const ATMOS14_address_26m = 0	'S/N: 20402
Const SN500SS_address_26m = 4 'S/N: 2510
Const GPSPort = ComC1 'Com port where GPS is connected

'Constants
Const Young_mult = 0.1666 'S/N: ------ Multiplier depend on the model 05103/05106 = 0.0980, 05108(Alpine)=0.1666 and 05305=0.1024

'============================================================
' TABLE MANAGEMENT ==========================================
'============================================================

'---------------------------------------------------------
'Power and Logger ----------------------------------------
Public BattV_U
Units BattV_U = V

' Data logger wiring panel temperature
Public PTemp_U
Units PTemp_U = degC

'---------------------------------------------------------
'Public clockmod -----------------------------------------
Public LoggerTime_U(9) As Long
Alias LoggerTime_U(2) = month_U
Alias LoggerTime_U(4) = hour_U
Alias LoggerTime_U(5) = minute_U
Alias LoggerTime_U(9) = doy_U

'---------------------------------------------------------
' ATMOS14-------------------------------------------------
Public ATMOS14_26m(4)
Alias ATMOS14_26m(1) = VP_26m
Alias ATMOS14_26m(2) = Temp_26m
Alias ATMOS14_26m(3) = RH_26m
Alias ATMOS14_26m(4) = AP_26m

Units Temp_26m = Deg_C
Units VP_26m = kPa
Units AP_26m = kPa

'---------------------------------------------------------
' YOUNG Wind Monitor--------------------------------------
Public WS_26m
Public WD_26m

Units WS_26m = m/s
Units WD_26m = deg

'---------------------------------------------------------
' SN500SS-------------------------------------------------
Public Rad_26m(4)
Alias Rad_26m(1) = Incoming_SW_26m
Alias Rad_26m(2) = Outgoing_SW_26m
Alias Rad_26m(3) = Incoming_UW_26m
Alias Rad_26m(4) = Outgoing_UW_26m

Units Rad_26m = W/m2

'---------------------------------------------------------
' CSAT3---------------------------------------------------

' CSAT3 execution parameter
Const CSAT_OPT = INT(1000/SFREQ1)  'Denominator in [mSec]

Public wind_26m(5)
Alias wind_26m(1) = Ux_26m
Alias wind_26m(2) = Uy_26m
Alias wind_26m(3) = Uz_26m
Alias wind_26m(4) = Ts_26m
Alias wind_26m(5) = diag_csat_26m

Units wind_26m = m/s
Units Ts_26m = degC
Units diag_csat_26m = none

' CSAT3 warning flags:
' 1) delta temperature, 2) poor signal lock,
' 3) amplitude high, or 4) amplitude low.
Public diag_bits_26m(4) As Boolean
Units diag_bits_26m = samples

Alias diag_bits_26m(1) = delT_f_26m
Alias diag_bits_26m(2) = sigl_f_26m
Alias diag_bits_26m(3) = amph_f_26m
Alias diag_bits_26m(4) = ampl_f_26m

' Diagnostic variables
Dim disable_flag_on_26m(2) As Boolean
Dim n_26m
Units n_26m = samples

' Working variables
Dim diag_csat_work_26m As Long

'Wind directions and speed.
Dim wnd_out_26m(8)
'Alias wnd_out_26m(1) = wnd_spd_26m - in compass coordinate system, same As CSAT3.
'Alias wnd_out_26m(2) = rslt_wnd_spd_26m - in compass coordinate system, same As CSAT3.
Alias wnd_out_26m(3) = wnd_dir_compass_26m
'Alias wnd_out_26m(4) = std_wnd_dir_26m - in compass coordinate system, same As CSAT3.
Alias wnd_out_26m(5) = wnd_spd_26m
Alias wnd_out_26m(6) = rslt_wnd_spd_26m
Alias wnd_out_26m(7) = wnd_dir_csat3_26m
Alias wnd_out_26m(8) = std_wnd_dir_26m

Units wnd_dir_compass_26m = degrees
Units wnd_spd_26m = m/s
Units rslt_wnd_spd_26m = m/s
Units wnd_dir_csat3_26m = degrees
Units std_wnd_dir_26m = degrees

'Working variables.
Dim wind_east_26m 'East wind in compass coordinate system.
Dim wind_north_26m 'North wind in compass coordinate system. 

'---------------------------------------------------------
' LI-7500A -----------------------------------------------
  
Public LIC75_26m(4) 'Licor output mode set equal to 6 !!!

Alias LIC75_26m(1) = LI_CO2m_26m  'CO2 [mmol/m3]
Alias LIC75_26m(2) = LI_H2Om_26m  'H2O [mmol/m3]
Alias LIC75_26m(3) = LI_Pres_26m  'Pressure [kPa]
Alias LIC75_26m(4) = LI_diag_26m  'Diagnostic value

Units LI_CO2m_26m = mmol/m3
Units LI_H2Om_26m = mmol/m3
Units LI_Pres_26m = kPa
Units LI_diag_26m = unitless  

Public diag_LI_bits_26m(4) As Boolean
Units diag_LI_bits_26m = samples
Alias diag_LI_bits_26m(1) = li_chopper_26m
Alias diag_LI_bits_26m(2) = li_detector_26m
Alias diag_LI_bits_26m(3) = li_pll_26m
Alias diag_LI_bits_26m(4) = li_sync_26m

Dim diag_licor_work_26m As Long

'---------------------------------------------------------
'GPS using the Serial Instruction ------------------------ 
'GPS16X-HVS at Campbell Scientific Factory Defaults
'Public GGAstring As String * 500
'Public RMCstring As String * 500
Dim NMEASent(2) As String * 100

Public GPSData(15)

Alias GPSData(1)=Latitude_A
Alias GPSData(2)=Latitude_B
Alias GPSData(3)=Longitude_A
Alias GPSData(4)=Longitude_B
Alias GPSData(5)=Speed
Alias GPSData(6)=Course
Alias GPSData(7)=MagVar
Alias GPSData(8)=FixQual
Alias GPSData(9)=NumSats
Alias GPSData(10)=Altitude
Alias GPSData(11)=PPS
Alias GPSData(12)=SecSinceGPRMC
Alias GPSData(13)=GPSReady
Alias GPSData(14)=MaxClockChange
Alias GPSData(15)=NumClockChange

Units Latitude_A=degrees
Units Latitude_B=minutes
Units Longitude_A=degrees
Units Longitude_B=minutes
Units Speed=knots
Units Course=degrees
Units MagVar=degrees
Units FixQual=code
Units NumSats=count
Units Altitude=meters
Units PPS=microseconds
Units SecSinceGPRMC=seconds
Units GPSReady=count
Units MaxClockChange=milliseconds
Units NumClockChange=count

'============================================================
' DEFINE DATA TABLES ========================================
'============================================================

Const TableName_Tower1_FastData = "PEAU_Fast"
Const FileName_Tower1_FastData = "CRD:" & TableName_Tower1_FastData & "_"
Public LastWrittenFile_Tower1_FastData As String * 40
ReadOnly LastWrittenFile_Tower1_FastData

'Const TableName_Tower1_WindData = "PEAU_Wind"
'Const FileName_Tower1_WindData = "CRD:" & TableName_Tower1_WindData & "_"
'Public LastWrittenFile_Tower1_WindData As String * 40
'ReadOnly LastWrittenFile_Tower1_WindData

Const TableName_Tower1_SlowData = "PEAU_Slow"
Const FileName_Tower1_SlowData = "CRD:" & TableName_Tower1_SlowData & "_"
Public LastWrittenFile_Tower1_SlowData As String * 40
ReadOnly LastWrittenFile_Tower1_SlowData


Const FileInterval_FastData = 24     '[h], create four files per day 'with a data rate of 10Hz, it produces 432'000 records per file
Const FileInterval_SlowData = 0     'Don't create new files
'Const FileInterval_WindData = 24     '[h], create one file per day 'with 60s data period, it would produce 17'280 records per file
Const FileTimeOnInt = 0              'new file at midnight


'---------------------------------------------------------
' FAST Table ---------------------------------------------
DataTable(FAST,True,-1)
  DataInterval(0,OFREQ1,mSec,0)
  TableFile(FileName_Tower1_FastData,64,-1,FileTimeOnInt,FileInterval_FastData,hr,0,LastWrittenFile_Tower1_FastData)  
  Sample(4,Ux_26m,IEEE4)        ' Ux_26m, Uy_26m, Uz_26m, Ts_26m
  Sample(4,LI_CO2m_26m,IEEE4)	' CO2_26m, H2O_26m, Pressure_26m, diag_Uicor_26m
  Sample(1,diag_csat_26m,UINT2) ' CSAT diagnostic word. Store as unsigned integer
EndTable

'---------------------------------------------------------
' SLOW Table ---------------------------------------------
DataTable(SLOW,True,-1)
  DataInterval(0,OFREQ2,Sec,0)
  TableFile(FileName_Tower1_SlowData,8,-1,FileTimeOnInt,FileInterval_SlowData,hr,0,LastWrittenFile_Tower1_SlowData) 
	'Sample(1,NMEASent(1),String)
	'Sample(1,NMEASent(2),String)
	'Sample(1,Latitude_A,FP2)
	'Sample(1,Latitude_B,FP2)
	'Sample(1,Altitude,FP2)
	'Sample(1,PPS,FP2)
	'Sample(1,SecSinceGPRMC,FP2)
	'Sample(1,MaxClockChange,FP2)
	'Sample(1,NumClockChange,FP2)

  'LOGGER-----------------------------------------
  Minimum(1,BattV_U,FP2,False,False)
  Average(1,PTemp_U,FP2,False)

  'ATMOS14----------------------------------------
  Average(1,VP_26m,FP2,False)
  Average(1,Temp_26m,FP2,False)
  Average(1,RH_26m,FP2,False)
  Average(1,AP_26m,FP2,False)
  
  'YOUNG Wind Monitor-----------------------------
  Average(1,WS_26m,FP2,False)        ' mean over OFREQ2 interval (here 1min)
  Maximum(1,WS_26m,FP2,False,False)  ' max. over a 1sec interval (wind gust)
  StdDev(1,WS_26m,FP2,False)         ' Std. over OFREQ2 interval (here 1min)
  Sample(1,WD_26m,FP2)
  
  'SN500SS----------------------------------------
  Average(1,Incoming_SW_26m,IEEE4,False)
  Average(1,Outgoing_SW_26m,IEEE4,False)
  Average(1,Incoming_UW_26m,IEEE4,False)
  Average(1,Outgoing_UW_26m,IEEE4,False)

  'CSAT3 & LI-7500A-------------------------------
  Average(4,Ux_26m,IEEE4,False)
  StdDev(1,Ux_26m,IEEE4,False)
  Average(4,LI_CO2m_26m,IEEE4,0)
  StdDev (4,LI_CO2m_26m,IEEE4,0)
  
  Sample (1,wnd_dir_compass_26m,IEEE4)
  Sample (1,wnd_dir_csat3_26m,IEEE4)
  Sample (1,wnd_spd_26m,IEEE4)
  Sample (1,rslt_wnd_spd_26m,IEEE4)
  Sample (1,std_wnd_dir_26m,IEEE4)

  Totalize(1,n_26m,IEEE4,NOT(disable_flag_on_26m(1) OR disable_flag_on_26m(2)))
  FieldNames("csat_warnings_26m")
  Totalize(1,n_26m,IEEE4,NOT(delT_f_26m) OR NOT disable_flag_on_26m(2))
  FieldNames("delT_f_Tot_26m")
  Totalize(1,n_26m,IEEE4,NOT(sigl_f_26m) OR NOT disable_flag_on_26m(2))
  FieldNames("sigl_f_Tot_26m")
  Totalize(1,n_26m,IEEE4,NOT(amph_f_26m) OR NOT disable_flag_on_26m(2))
  FieldNames("amph_f_Tot_26m")
  Totalize(1,n_26m,IEEE4,NOT(ampl_f_26m) OR NOT disable_flag_on_26m(2))
  FieldNames("ampl_f_Tot_26m")
  
  Totalize(1,n_26m,IEEE4,li_chopper_26m)
  FieldNames("li_chopper_26m")
  Totalize(1,n_26m,IEEE4,li_detector_26m)
  FieldNames("li_detector_26m")
  Totalize(1,n_26m,IEEE4,li_pll_26m)
  FieldNames("li_pll_26m")
  Totalize(1,n_26m,IEEE4,li_sync_26m)
  FieldNames("li_sync_26m")
  
EndTable


''*** Working Data Tables ***
''Compute the wind direction This data is output every OUTPUT_INTERVAL minutes.
'DataTable (wnd_vec,TRUE,1)
'  DataInterval (0,OFREQ2,Min,1)
'  'Compute wind direction from CSAT3 data.
'  WindVector (1,wind_east_26m,wind_north_26m,IEEE4,disable_flag_on_26m(1),0,1,2)
'  WindVector (1,Uy_26m,Ux_26m,IEEE4,disable_flag_on_26m(1),0,1,2)
'EndTable 


'==========================================================
' MEASUREMENTS ============================================
'==========================================================
' Main Program
BeginProg

	'Set all CSAT3 variables to NaN.
	Move(Ux_26m,5,NaN,1)

	'Set the SDM clock speed.
	SDMSpeed(SDM_PER)

	n_26m = 0

	'Main Scan+++++++++++++++++++++++++++++++++++++++++++++++
	Scan(SFREQ1,mSec,10,0)	  

		SDMTrigger()

		'***Measure CSAT3 and LI7500-------------------------
		
		'Get data from CSAT3, 98: Get wind & sonic temperature data after a group trigger 
		' CSAT_OPT: 10Hz execution parameter
		CSAT3(Ux_26m,1,CSAT3_address_26m,98,CSAT_OPT)
		'Get data from LI7500
		CS7500(LI_CO2m_26m,1,LIC75_address_26m,6)

		'CSAT3 processing------------------------------------
		'Define 61502 as NaN
		If (diag_csat_26m = NaN) Then 
		(diag_csat_26m = 61502)
		Ux_26m = NaN
		Uy_26m = NaN
		Uz_26m = NaN
		Ts_26m = NaN
		EndIf  
		
		'Break up the 4 CSAT3 warning flags in 4 separate bits
		diag_csat_work_26m = diag_csat_26m
		delT_f_26m = diag_csat_work_26m AND &h8000
		sigl_f_26m = diag_csat_work_26m AND &h4000
		amph_f_26m = diag_csat_work_26m AND &h2000
		ampl_f_26m = diag_csat_work_26m AND &h1000

		'Turn on the intermediate processing disable flag when any CSAT3 warning flag is
		'high, including the special cases NaN (61502), a Lost Trigger (61440), No Data
		'(61503), an SDM error (61441), or wrong CSAT3 embedded code (61442).
		disable_flag_on_26m(1) = diag_csat_work_26m AND &hf000
		'Turn on only when CSAT3 diagnostic warning flags are set.
		disable_flag_on_26m(2) = (disable_flag_on_26m(1) AND NOT (Ts_26m=NaN))

		'Save the four most significant bits of the CSAT3 diagnostics, except for the
		'special cases NaN (61502), a Lost Trigger (61440), No Data (61503), an SDM
		'error (61441), or wrong CSAT3 embedded code (61442).
		If (diag_csat_work_26m<&hf000) Then 
		  diag_csat_26m = INT(diag_csat_work_26m/&h1000)
		EndIf

		'Licor diag -----------------------------------------------
		diag_Licor_work_26m = LI_diag_26m
		li_chopper_26m = diag_licor_work_26m AND &h80
		li_detector_26m = diag_licor_work_26m AND &h40
		li_pll_26m = diag_licor_work_26m AND &h20
		li_sync_26m = diag_licor_work_26m AND &h10

		' Call data tables and store Fast Data-----------------
		CallTable FAST
		
		'*** Measure the YOUNG Wind Monitor-------------------------------
		'--- rd(pulse)=P1, gn=H1, bl=VX1, bk/gy/wh(GD)=G, cl=G | Multiplier depend on the model 05103/05106 = 0.0980, 05108=0.1666 and 05305=0.1024
		'Measure wind speed as a mean of the last second (1000ms) 
		PulseCount(WS_26m,1,P1,5,1,Young_mult,0)
		'Measure wind direction
		BrHalf(WD_26m,1,mV5000,1,VX1,1,2500,True,20000,60,355,0)
		If WD_26m>=360 OR WD_26m<0 Then WD_26m=0
		
		CallTable SLOW
		'PulseCount instruction not allowed in SlowSequence
		
	NextScan 
  
  
	'++++++++++++++++++++++++++++++++++++++++++++++++++++++++
	SlowSequence
	
	Scan (SFREQ2,Sec,5,0)
	  
		'*** Measure the GPS using the Serial instruction-----------------
		'--- rd=12V, wh(RX)=RS-232, gr(TX)=RS-232, bk/ye/bl=G
		'GPS(GPSData(),-ComC5,0,100,NMEASent())
		GPS(GPSData(),-ComC5,0*3600,500,NMEASent())

		'Get logger time
		RealTime(LoggerTime_U)

		'*** Measure the Datalogger Battery Voltage-----------------------
		Battery(BattV_U)

		'*** Measure the Datalogger Wiring Panel Temperature--------------
		PanelTemp(PTemp_U,60)
		
		'*** Measure the ATMOS14 variables--------------------------------
		'--- br(energy)=5V, or(data)=C7, ba(GD)=G
		'Query sensor for 4 SDI-12 outputs.  Default address for all Decagon Digital sensors is 0. 
		SDI12Recorder(ATMOS14_26m(),C7,ATMOS14_address_26m,"C!",1.0,0,-1)
		
		'*** Measure the YOUNG Wind Monitor-------------------------------
		'--- rd(pulse)=P1, gn=H1, bl=VX1, bk/gy/wh(GD)=G, cl=G | Multiplier depend on the model 05103/05106 = 0.0980, 05108=0.1666 and 05305=0.1024
		'Measure wind speed as a mean of the last second (1000ms) 
		'PulseCount(WS_26m,1,P1,1,1,Young_mult,0)
		'Measure wind direction
		'BrHalf(WD_26m,1,mV5000,1,VX1,1,2500,True,20000,60,355,0)
		'If WD_26m>=360 OR WD_26m<0 Then WD_26m=0
		'PulseCount instruction not allowed in SlowSequence
		
		'*** Measure the SN500SS net radiation----------------------------
		'--- rd(energy)=12V, wh(data)=C7, bk/cl(GD)=G
		SDI12Recorder(Rad_26m(),C7,SN500SS_address_26m,"MC!",1.0,0,-1)

	CallTable SLOW
  
	NextScan

	EndSequence

EndProg
