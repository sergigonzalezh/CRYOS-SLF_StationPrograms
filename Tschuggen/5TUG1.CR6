Public TaRHdata2(2) : Alias TaRHdata2 = TempAir_act2, RelHum_act2
Units TempAir_act2 = °C : Units RelHum_act2 = %
Public TaRHdata3(2) : Alias TaRHdata3 = TempAir_act3, RelHum_act3
Units TempAir_act3 = °C : Units RelHum_act3 = %

'***   constants & variables for snow surface temp Waljag  ****************

Const SnowSurfTemp_IRsensor = True
Const SnowSurfSDI_Address = "5"
Const SnowSurfSDI_ReadCMD = "M1!"
'variables for Waljag SnowSurfSDI-sensor, IR-sensor for snow surface temperature
Public SnowSurfSDI_data(2) : Units SnowSurfSDI_data() = °C
