'***   constants & variables for irgason sonic wind   ****************
Public sonic_irga(12)
Alias sonic_irga(1) = Irga_Ux
Alias sonic_irga(2) = Irga_Uy
Alias sonic_irga(3) = Irga_Uz
Alias sonic_irga(4) = Irga_Ts
Alias sonic_irga(5) = Irga_diag_sonic
Alias sonic_irga(6) = Irga_CO2
Alias sonic_irga(7) = Irga_H2O
Alias sonic_irga(8) = Irga_diag_irga
Alias sonic_irga(9) = Irga_cell_tmpr
Alias sonic_irga(10) = Irga_cell_press
Alias sonic_irga(11) = Irga_CO2_sig_strgth
Alias sonic_irga(12) = Irga_H2O_sig_strgth
Units Irga_Ux = m/s
Units Irga_Uy = m/s
Units Irga_Uz = m/s
Units Irga_Ts = C
Units Irga_diag_sonic = arb
Units Irga_CO2 = mg/m^3
Units Irga_H2O = g/m^3
Units Irga_diag_irga = arb
Units Irga_cell_tmpr = C
Units Irga_cell_press = kPa
Units Irga_CO2_sig_strgth = arb
Units Irga_H2O_sig_strgth = arb

'***   constants & variables for snow drift sensor (particle counter)  ****************
Const FlowCapt_Address = "0"         'SDI12-command of FlowCapt FC4 snow drift sensor
Const FlowCapt_ReadCMD = "M!"        'SDI12-command to read all the data from sensor
Public SnowDrift_FC4(8) : Alias SnowDrift_FC4 = SnowPartFluxMin, SnowPartFluxAvg,   SnowPartFluxMax, SnowPartFluxStd, SnowPartFluxCumul, WindSpeedMin_FC4,   WindSpeedAvg_FC4, WindSpeedMax_FC4
Units SnowPartFluxMin = g/m²/s : Units SnowPartFluxAvg = g/m²/s
Units SnowPartFluxMax = g/m²/s : Units SnowPartFluxStd = g/m²/s
Units SnowPartFluxCumul = g/m² : Units WindSpeedMin_FC4 = km/h
Units WindSpeedAvg_FC4 = km/h : Units WindSpeedMax_FC4 = km/h

'***   constants & variables for four-component radiation sensor  ********************
Const SN500SS_Address = "0"          'SDI12-address of SN-500-SS radiation sensor
Const SN500SS_ReadCMD = "MC!"        'SDI12-command to read the sensors values
Const SN500SS_HeatOnCMD = "XHON!"    'SDI12-command to switch the sensors heater on
Const SN500SS_HeatOffCMD = "XHOFF!"  'SDI12-command to switch the sensors heater off
Public RadNet_SN500SS(4) : Units RadNet_SN500SS() = W/m²
Alias RadNet_SN500SS = ISWR, RSWR, ILWR, OLWR
'ISWR = downwelling shortwave radiation [W/m²]
'RSWR = upwelling (reflected) shortwave radiation [W/m²]
'ILWR = downwelling longwave radiation [W/m²]
'OLWR = upwelling (emitted) longwave radiation [W/m²]

Public ISWRmax : Units ISWRmax = W/m²
Const ISWRmax_RunNr = 30 / SlowScanInterval       'running maximum over ½ h
Public SN500SS_HeaterActive As Boolean : ReadOnly SN500SS_HeaterActive
Dim SN500SSSpecialCMDresponse As String * 30   'used for SDI12Recorder with commands
Dim SN500SS_Heater_TimerValue

'***   constants & variables for ClimaVUE50 weather sensor  **************************
Const ClimaVueAddress = "1"          'SDI12-address of ClimaVUE50-sensor
Const ClimaVue_StdReadCMD = "R7!"    'standard SDI12 read command for sensors values
Const Clima_TRH_ReadCMD = "C!"       'read command for ClimaVUE50, CS215 & HygroVUE10

Public ClimaVueData(14) : Alias ClimaVueData = SolarRad_ClimaVue, Precip_ClimaVue,   LightStrikesCnt, LightStrikesDist, WindSpeed_ClimaVue, WindDir_ClimaVue,   WindSpeedMax_ClimaVue, TempAir_ClimaVue, PresVapour, PresBaroAbs, RelHum_ClimaVue,   TempHumSens_ClimaVue, TiltNS_ClimaVue, TiltWE_ClimaVue 'values for R7!-SDI12-command
Units SolarRad_ClimaVue = W/m² : Units Precip_ClimaVue = mm
Units LightStrikesDist = km : Units WindSpeed_ClimaVue = m/s
Units WindDir_ClimaVue = ° : Units WindSpeedMax_ClimaVue = m/s
Units TempAir_ClimaVue = °C : Units PresVapour = hPa : Units PresBaroAbs = hPa
Units RelHum_ClimaVue = % : Units TempHumSens_ClimaVue = °C
Units TiltNS_ClimaVue = ° : Units TiltWE_ClimaVue = °
Public Wind_ClimaVue_DataInvalid As Boolean    'to disable processing in datatable
Dim LightStrikesDist_DataInvalid As Boolean    'if distance is 0, for minimal function

'*** constants & variables for SHM31 *************************
Const SHM31_StartupDelay = 60 'time for sensor to have good values [s]
Const SHM31_SDIAddress = "1" 'SDI12-address of SHM 31 snow heigt sensor (Werksauslieferung war "0"!)
'Const SHM31_ReadCMD = "M!" 'SDI12-command to read all data from the sensor
Const SHM31_ReadCMD_0 = "R0!" 'SDI12-command read data buffer 0 from sensor
Const SHM31_ReadCMD_1 = "R1!" 'SDI12-command read data buffer 1 from sensor
Const SHM31_CalibCMD = "XARV!" 'SDI12-command for offset and angle calibration
Const SHM31_CalibRESP = SHM31_SDIAddress & "XARVok" 'respond after the command
'Const SHM31_ResetCMD = "XRES!" 'SDI12-command for a reset of the sensor
'Const SHM31_SetHeatCtrlCMD = "XPHEP1!" 'SDI12-command to enable the heater control on the HeaterEnablePin / EXT_TRIG_IN
Const SHM31_ResetHeatCtrlCMD = "XPHEP0!" 'SDI12-command to disable the heater control on the HeaterEnablePin / EXT_TRIG_IN
Const SHM31_MeasIntervalCMD = "XPATI!" 'SDI12-command to read Measurement Intveral, Default: 60s
Const SHM31_MeasIntervalChangeCMD = "XPATI+30!" 'SDI12-command to set Measurement Intveral, Default: 60s
Const SHM31_LaserMeasIntervalCMD = "XPLMI!" 'SDI12-command to read Laser Measurment Interval, Default: 10000ms
Const SHM31_LaserMeasIntervalChangeCMD = "XPLMI+5000!" 'SDI12-command to set Laser Measurment Interval, Default: 10000ms
'Const SHM31_HeaterDefrostModeOn = "XPHDM1!" 'SDI12-command to enable heaterDefrost Mode
	    '1=during sensor start (with values “HDP”, “HDR”, “HDB”, “HDW” for both heaters (block and window))	
Const SHM31_DefrostStartCMD = "XHDS!" 'SDI12-command to start the defrost cycle
'Const SHM31_DefrostStopCMD = "XHDE!" 'SDI12-command to stop the defrost cycle
      'defrost mode can be used automatically at startup of the sensor or if the sensor
      'shall be heated for a certain time, regardless the temperatures (with a higher
      'temperature threshold) - it isn't used currently
Const SHM31_ViewBlockedError = 15 'error code if signal is too weak
Const SHM31_TempLaserLow = 23 'error code for laser temperature too low
Public SHM31_DoCalibration As Boolean 'flag to execute a calibration of SHM31 sensor
Public SHM31_ChangeParam As Boolean 'flag to execute a calibration of SHM31 sensor
Public SHM31_Answer(8) : Alias SHM31_Answer = SHM31_Timestamp, SHM31_SnowHeight, SHM31_TempBlock, SHM31_TempAmbient, SHM31_TempLaser, SHM31_SignalQuality, SHM31_Tilt, SHM31_ErrorCode
Units SHM31_Timestamp = s : Units SHM31_SnowHeight = mm : Units SHM31_TempBlock = °C
Units SHM31_TempAmbient = °C : Units SHM31_TempLaser = °C : Units SHM31_Tilt = °
Units SHM31_ErrorCode = code
'Dim SHM31_Data(4) 'to store temporary data from sensor
Const SHM31_Buffer0_Index = 1 'to access only first part of the data-array
Const SHM31_Buffer1_Index = 5 'to access only second part of the data-array
Public SHM31_SpecialCMDresp As String * 30 'used for SDI12Recorder with commands
Public SHM31_MeasIntervalCMDresp As String * 30 'used for SDI12Recorder with commands, Default: 60s
Public SHM31_LaserMeasIntervalCMDresp As String * 30 'used for SDI12Recorder with commands, Default: 10000ms
Dim SHM31_DataInvalid As Boolean 'used to disable processing in datatable
'Const Timer_SHM31_Heater = 5         'timer to control the sensors heating
'Public SHM31_MeasurementInterval = 30
'Public SHM31_LaserMeasurmentInterval = 5000
