'*************************************************************************************
'* Tschuggen - Meteostation                                                        
'*   Consisting the station at the Tschuggen Fluela, next to Fluelastrasse
'*   near Gasthaus Tschuggen
'*   
'*   
'*************************************************************************************
'* program:  5STUG1.CR6
'* author:   T. Hartmann, M. Hohl, DL
'* 
Public StrRev As String * 6 = "v1.1.1"
'*************************************************************************************
'* revision history:
'*    v1.1.1 17.11.2025
'*           SHM31, removed the 30min heating interval,
'*           since it never became active with a 2-minute offset in the 5-minute slow scan
'*           added BattThreshold for heating
'*    v1.1.0 10.10.2025 DL
'*           removed Geolux LX-80S
'*           new sensor SHM31 Laser Snowheigt on SDI12,
'*           integration as in the new snow station NSM 
'*    v1.0.0 01.04.2024 partly copied from example programs from campbell
'*    v0.0.1            copy parts from Braemabuehl station
'*************************************************************************************
'* sensors:  1 x Irgason combined gas analyzer and ultrasonic anemometer, Pwr U12
'*           1 x SN50ss Apogee digital radiation balance sensor, Pwr U8
'*           3 x Campbell HygroVUE10(air temp. & rel.hum)
'*           1 x SnowSorfSDI Waljag (IR-snow surface temperature)
'*           1 x Axis network Camera M3115-LVE witch Mobotix POE injector 
'*                MX-NPA-PoE-RJ controlled via Mobile Router
'*           1 x Mobile-Router power controlled by logger
'*           1 x ClimaVue 10 compact digital weathersensor
'*           1 x SnowVue10 digital snow hight sensor (or similiar)
'*           1 x Flow Capt FC4 solid particle flux intensities and wind speeds
'*           1 x GPS Antenna GPS16x
'*           1 x Faro laser scanner (periodically mounted)
'*           1 x Snow particle counter SPC (periodically mounted)
'*           1 x FARO Laserscanner (periodically mounted)
'*           1 x Windows PC to controll FARO Laserscanner
'*           1 x SHM31 Laser Snowheight
'*************************************************************************************
'* use instructions and functional description:
'*  - 
'*  - the modem is driven only multiple times a day 
'*  - the loggers clock can be synchronised automatically over GPS
'*  - twice a month, on first and on 15th day at 12 o'clock or startup, station status is stored
'*  - as the standard at SLF, the logger runs on wintertime (UTC+1)
'*************************************************************************************

'***   general constants   ***********************************************************
Const KelvinToCelsius = -273.15      'for conversion from °K to °C, +273.15°
Const toKiloB = 2^10                 ' = 1024, for conversion from B to kB
Const MeterToCenti = 100             'for conversion from meters to centimeters

Const SensorOffValue = 6999          'kind of NaN indicating sensor is switched off
Const SensorErrorValue = 6998        'indicationg sensor has an error

Const T_Start = 0 : Const Reset_Start = 2 : Const Stop_Reset = 3 : Const Read_only = 4
  'options for the use of timer, instead of using the numbers

Const NO_ON = 1  : Const NO_OFF = 0     'for switches, normally open
Const NC_ON = 0 : Const NC_OFF = 1      '  or normally closed

Const ControlTerminal = 0 : Const UniversalTerminal = 1

Const LF = CHR(10)         'ASCII-value for a Line Feed
Const CR = CHR(13)         'ASCII-value for a Carriage Return
Const QM = CHR(34)         'ASCII-value for a quotation mark


'***   constants & configuration settings   ******************************************
ConstTable
  '***   program control (conditional compilation)   *********************************
  Const TESTING = False              'some variables are visible for troubleshooting
  Const MainScanInterval = 60         'interval of main scan-loop in [s]
  Const SlowScanInterval = 5         'interval of slow sequence scan in [min]
  Const FastScanIntervall = 50        ' [mSec] fast output (LI7500, 20Hz)
  Const MeasureMeteoInterval = 60    'interval of meteodata measurement [s]
  Const MeteoRecordInterval = 10     'interval of stored data records [min]
  Const ServiceRecordInterval = 30   'interval for general service data [min]
  Const StatusRecordInterval = 1     'interval for status-table call [mon]
  Const StatusTimeOnInt1 = 43200     'time into interval [s], first day at noon
  Const StatusTimeOnInt2 = 1339200   'time into interval [s], 15th day at noon
  Const ResetForceMeasurement = 60   'interval to check and if needed reset flag [min]  

  Const SnowSurfTemp_minVal = -40.0  'minimum possible value for snow surface
  Const SnowSurfTemp_maxVal = 55.0   'maximum possible value for snow surface
  
  Const SensorsPwrPort = SW12_2      'power of the Station except logger
  Const IRGASON_normalOutCMD = 1     'EC100-command for normal output - Ux,Uy,Uz,Ts,
        'sonic diag,CO2,H2O,gas diag,ambient temp,ambient pressure,CO2 signal,H2O signal

  Const IRGASON_SDMaddr = 1          'SDM-address of IRGASON 
  Const IRGASON_SDMport = U9         'SDM-port used for the IRGASONs
  Const IRGASON_PwrPort = U12
        
  Const ModemSigQualInterval = 30    'read the modems signal strength interval [min]
  Const ModemSigQualTime = 28        'measure signal strength at 28th and 58th [min]
  Const ModemPwrPort = SW12_1         'power of cellular router, solid-state relay No, ON SW12
  Const ModemPwrOption = 5             'parameter used for IPNetPower-function
  
  Const BattMin_Time = 15            'record batterys minimum over this time [min]
  
  Const HygroVUE10_enableRHrelIceCorr = True   'enable correction, humidity above ice
  Const HygroVUE10_thresholdRHrelIceCorr = -0.0 'correct humidity for temps below [°C]
  Const HygroVUE10_SDIPort = C3      'data channel for HygroVUE10 TaRH-sensor
  Const SnowSurf_SDIPort = C1        'data channel for Waljag snow surface sensor
  Const SnowSurfSDI_Offset = 0
  
  Const BattThresholdCritical = 11.0
  Const Irgason_BattThreshold = 11.3
  Const Modem_BattThreshold = 11.5
  Const Spc_BattThreshold = 11.8
  Const Laserscanner_BattTreshold = 12.0
  Const SN500SS_HeatBattThreshold = 12.3       'if battery drops below, don't heat [V]
  Const SHM31_DefrostBattThreshold = 12.3      'if battery drops below, don't defrost [V] (Minimum heating remains active)
  
  Const SN500SS_HeatTime = 5         'heat sensor for time [min] (depending on scan)
  Const SN500SS_HeatDeadTime = 90    'after heating, don't heat anymore for [min
  Const SN500SS_HeatTempThreshold = 2          'heat if air temp is below [°C]
  Const SN500SS_HeatHumThreshold = 90          'heat if humidity is above [%]
  Const SN500SS_HeatRadMinThreshold = 100      'heat if SWin radiation is below [W]
  Const SN500SS_RadMinTimewindowInt = 1440     'check for minimal radiation from
  Const SN500SS_RadMinTimewindowStart = 570    '  9:30 to 14:30 local time
  Const SN500SS_RadMinTimewindowStop = 870
  Const SN500SS_PwrPort = U8  
  
  Const SN500SS_SDIPort = U1                   'data channel for the radiation sensor
  Const FlowCaptSDIPort = U5                   'data port for FlotCapt
  Const ClimaTRH_SDIPort = U3                  'data channel for ClimaVUE50, CS215 & HygroVUE10
  Const GPSPort = ComRS232                     'Com port where GPS is connected
  Const SHM31_SDIPort = U7
  Const SpcPwrPort = C2                        'power SPC exgernal supply
  Const LaserPwrPort =  C4              'power FARO FOCUS S120 Laserscanner
  Const LaserPcPwrPort = U6             'power PC to control FARO Laserscanner
  Const LaserScanNotFinishedMask = &B10
  Const LaserPowerDownPort = U4
EndConstTable

'***   constants for binary codes status variable   **********************************
Const TaRH1_off        = 2^0
Const TaRH1_error      = 2^1
Const TaRH2_off        = 2^2
Const TaRH2_error      = 2^3
Const TaRH3_off        = 2^4
Const TaRH3_error      = 2^5
Const SnowSurf_off     = 2^6
Const SnowSurf_error   = 2^7
Const WindMeasure_off  = 2^8
Const SN500SS_off      = 2^9
Const Spc_off          = 2^10
Const Laser_off        = 2^11
Const SensorPwr_off    = 2^12


'***   constants for timer       ******************************************************
Const Timer_ClimaVueTRHFC4_Reset = 2 'timer for sensors reset
Const Timer_SN500SS_Reset = 3        'timer for sensors reset
Const Timer_SN500SS_Heater = 4       'timer to control the sensors heating

'***   set station specific parameters   *********************************************
StationName (Tschuggen)                   'assign stations name to the logger
Public ModemInterval = 60       'interval  [min]
Public ModemStartTime = 0      'enable Router every hour, Start at 0 
Public ModemEndTime = 15        'disable Router after 15 min
Public ModemPwrManual As Boolean = True

Public ModemCheckSigInterval = 60
Public ModemCheckSigStartTime = 5
Public ModemCheckSigEndTime = 10

Public LaserPowerInterval = 1440
Public LaserPowerStartTime = 665 
Public LaserPowerEndTime = 675
Public LaserPwrManual As Boolean = False
Public LaserScanNotFinished As Boolean = True
Public LaserPcPwrManual As Boolean = False

Public DisableLaser As Boolean = True

Public DisableSpc As Boolean = False

Public waitForOneMainScanIntervalOver As Boolean = False
ReadOnly waitForOneMainScanIntervalOver


'---  constants for table handling   ------------------------------------------
Const TableName_Meteo = "Tschuggen_Meteo"
Const TableName_Service = "Tschuggen_Service"
Const TableName_Status = "Tschuggen_Status"
Const TableSize_Meteo = -1           'use remaining memory for records of meteo-
Const TableSize_Service = -1         '  and for service data
Const TableSize_Status = 100         'recorded twice a month, space more than 4 years


'***   further conditional and miscellaneous parameters   ****************************
Const IPinterface = 1                'constant for IP-reading of PPP-interface
Const NTPserver As String = "0.ch.pool.ntp.org"          'server for clock adjustment
  'neither ntp1.slf.ch nor its address 195.176.244.113 worked for NTP-adjustment
Const UTCoffset = 3600               'CET without CEST = UTC+1 [s]
Const NTPmaxDev = 5000               'maximal time deviation without adjustment [ms]
Const NTPinterval = 1440             'synchronise clock once a day [min]
Const NTPtimeOnInt = 722             'synchronise clock at 12:00 CET [min]
Const NTPTimeOnIntEnd = 735          'stop at 12:15 CET [min]

Const RouterPW = "EC02FF05E089E0E9C7E8FE12b86F4282"    ' password for http request
Const IP_RUTModuleRouter = "192.168.1.1"  'router IP
Const URI_RUTModuleRouter = "http://192.168.1.1/ubus"
Const RUTModuleHeader = "Content-Type: application/json"
Const RUTModuleContent = "{"+QM+"jsonrpc"+QM+":"+QM+"2.0"+QM+", "+QM+"id"+QM+":1, "+QM+"method"+QM+":"+QM+"call"+QM+", "+QM+"params"+QM+":[ "+QM+"00000000000000000000000000000000"+QM+", "+QM+"session"+QM+", "+QM+"login"+QM+", {  "+QM+"username"+QM+":"+QM+"admin"+QM+", "+QM+"password"+QM+":"+QM+"EC02FF05E089E0E9C7E8FE12b86F4282"+QM+"}]}"
Public get_success = 0               ' Variable if HTTPGet is successful 
Public responseString As String * 1000 'String to store HTTPGet information
Public cutString As String * 560
Public RUTUbusRpcSession As String * 560

'***   variables for user control   **************************************************
Public ForceMeasurements As Boolean = False             'flag to force measurements
Public EnableWindMeasure As Boolean = True              'enable wind measurement (IRGASON)
Public EnableTaRhMeasure As Boolean = True              'enable tempAir & relHum
Public EnableSnowSurfaceMeasure As Boolean = True       'enable snow surface measurm.
Public SensorPowerEnable As Boolean = True                'enable all sensors

Public DisableSN500SS As Boolean = False

'***   variables for measured values   ***********************************************
'***   service variables   ***********************************************************
Public LoggerTemp : Units LoggerTemp = °c      'system variables
Public BatteryVoltage : Units BatteryVoltage = V
Public BatteryVoltage_min : Units BatteryVoltage_min = V
Const BattMin_RunNr = BattMin_Time * 60 / MainScanInterval
  '  minimum of the battery voltage, BattMin_Time [min] & MainScanInterval [sec]
Public ModemNetTech As String * 10   'holds used technology, LTE (4G), WCDMA (3G) or 2G
Public ModemSigQual(3) = {NaN,NaN,NaN}
Alias ModemSigQual = ModemRSSI, ModemRSRP, ModemRSRQ
Units ModemRSSI = dBm : Units ModemRSRP = dBm : Units ModemRSRQ = dB
  'signal quality is respresented, with 2G by RSSI and with 4G by RSRP and RSRQ
'Public LoggerIP As String            'holds the IP after successful mobile connection
'Public LoggerNTPdeviation : Units LoggerNTPdeviation = ms
  'storing loggers clock deviation after a NTP-check, prior to a clock adjustment
'Public LoggerNTPdevMax = 0 : Units LoggerNTPdevMax = ms  'maximum clock deviation
'Public NTPsyncEnable As Boolean = True       'en- or disable clock-synchronisation over NTP
'Public TestEnabled As Boolean : ReadOnly TestEnabled     'to show test mode

'***   miscellaneous variables & constants   *****************************************
Public Logger As String              'several status information about the system
Public ProgramName As String * 50
Public ProgStartTime As Long
Public ProgramSignature, ProgramErrors, CalibErrors
Public BackupBattery As String * 20
Public CardsFreeMemory As Long = 0 : Units CardsFreeMemory = kB
Public StatusActual As Long = 0      'actual status or running program, binary coded
Public StatusDisabledSensors As Long = 0       'showing which senors are disabled

Dim LoggersTime (9)                  'holds actual loggers time (year, month, day of month,
  ' hour of day, minutes, seconds, microseconds, day of week, day of year)
Alias LoggersTime (8) = Today      'actual day of the week (1-7; Sunday = 1)
Alias LoggersTime (5) = Minute_act   'actual minute

'***   constants & variables for 3x HygroVue10 Temp. rel. humidity  ****************
'***   constants & variables for 3x HygroVue10 Temp. rel. humidity  ****************

Const TaRH_HygroVUE10 = True         'for air temperature and relative humidity
Const HygroVUE1_Address = "1"       'SDI12-address of HygroVUE10 TaRH-sensor
Const HygroVUE2_Address = "2"       'SDI12-address of HygroVUE10 TaRH-sensor
Const HygroVUE3_Address = "3"       'SDI12-address of HygroVUE10 TaRH-sensor
Const HygroVUE10_ReadCMD = "M!"      'command for air temperature [°C] & humidity [%]
Const HygroVUE10_RHrelIceCorr_multiplier = 0.0084   'parameters for humidity correction
Const HygroVUE10_RHrelIceCorr_offset = 0.9964       '  above ice (freezing temperatures)
  'for lower temperatures: RHreal = RHmeasured / (multiplier * TempActual + offset)
'variables for the air temperature and relative humidity measurement (HygroVUE10)
Public TaRHdataTemp(2) : Alias TaRHdataTemp = TempAir_act_Temp, RelHum_act_Temp
Units TempAir_act_Temp = °C : Units RelHum_act_Temp = %
Public TaRHdata1(2) : Alias TaRHdata1 = TempAir_act1, RelHum_act1
