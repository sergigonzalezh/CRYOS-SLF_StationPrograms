' ---------------------------------------------------------
' CR6 Series
' Program: Zugspitze
' Author: Sergi Gonzalez from Thierry Hartmann program - Updates for modem suggested by David Lehmann
' Date: 01.05.2026, Version 3.0
' Based on v2.0 (20.04.2026)
' Changes in v3.0:
'   - Merged ZUGSPITZEwind table into ZUGSPITZE1Min (all 1-min meteo in one table)
'   - Merged ZUGSPITZE1Min_HS (median snow height) into ZUGSPITZE1Min
'   - Replaced 4x ZUGSPITZEfast tables + DOY Select Case with single
'     ZUGSPITZEfast table using TableFile for daily TOB3 files on card
'     (same approach as Tschuggen IrgaWindFast)
'   - Added FieldNames for clarity (Tschuggen convention)
'   - Added version string (Tschuggen convention)
'
' Program measures:
'  1x Licor LI-7500A C02/H20 Gas Analyzer
'  1x Campbell CSAT3 three dimensional sonic anemometer
'  1x CS215 Temperature/Relative Humidity (TRH)
'  1x SI-111 IR Surface Temperature (IRT)
'  1x SR50A Snow depth (i.e. distance to surface)
'  2x 05108-45 Young wind monitor (WS,WD)
'  1x GPS16X-HVS Garmin GPS
'  Power management for SPC-95 Snow Particle Counter

' Sensor Wiring: wire color (function) -> port
' color code: red(rd), green(gn), blue(bl), yellow(ye), white(wh), black(bk)
' color code: brown(bn), grey(gy), orange(or), violet(vt), pink(pk)

' Power consumption:
'   mA at 12V =  W  LI-7500A (at 25C)
'   mA at 12V =  W  CSAT3 (at 25C)
'     2mA at 12V =  0.024W  CS215 during 1s for measurement (quiescent: 70uA)
'     0mA at 12V =  0.000W  SI-111
'   250mA at 12V =  3.000W  SR50A during 1s for measurement (quiescent:  1mA)
'   switched excitation voltage supplied by data logger, 2x Young Wind
'    65mA at 12V =  0.780W  GPS Receiver
'    50mA at 12V =  0.600W  CR6 estimated; 67mA @20Hz, 3mA @1Hz scan

' NOTE: SR50A is expected to have SDI-12 address 1, CS215 the SDI12 address 0
' To change this address, connect to logger using LoggerNet
' Make sure only *one* SDI12 interface is connected to the same port
' Choose Datalogger -> Terminal Emulator
' Choose "Open terminal" and hit enter multiple times, until "CR6>" appears
' Type SDI12 and select the port (for this program, select U9)
' Verify address by typing: !?
' Change address by typing: XAY!, where X = old address and Y = new address
' Verify address again by typing !? to see if change was successful.
' ---------------------------------------------------------

SequentialMode

' DECLARATIONS=============================================

Public StrRev As String * 6 = "v3.0.0"

' Declare local time offset relative to UTC time for GPS
Const LOCAL_TIME_OFFSET = 0    ' Local time offset relative to UTC time

' Power cut-off values (battery voltage)
Const LowVoltSPC = 12.2        ' Low power threshold for SPC-95,  (PowerSPC, SW1)

' SPC-95 parameters
' Values for field installation
                                       ' the following line should force the creation of a new file after XXX minutes
Const SPC_Forced_Restart = 10080       ' In minutes: Trigger restart of SPC every XXX minutes (10080 min = 7 days)
Const SPC_Forced_Restart_Time = 1      ' In minutes: SPC delay period (power off) before triggered restart 
Const SPC_LowPowerOff = 60             ' In minutes: At low battery, SPC idle time (power off) before restart (720 min = 12 h)

' Scan frequencies 
Const SFREQ1 = 100    ' [mSec] Main scan interval, (100mSec = 10Hz)
Const SFREQ2 = 60     ' [Sec]  Slow sequence (1min)

' Output frequencies
Const OFREQ1 = 100    ' [mSec] fast output (CSAT3, LI7500, 10Hz)
Const OFREQ2 = 60     ' [Sec]  slow output (Meteo/Stat data, 1min)

' Table Management-----------------------------------------
' v3.0: Fast data uses a single table with TableFile for automatic daily
'       TOB3 files on the card (same approach as Tschuggen IrgaWindFast).
'       All 1-min data (wind, meteo, snow height) merged into one table.
Const nRec2 = 247*24*60  '#recs to allocate for slow output for 1 year @1min


'----------------------- CSAT3 --------------------------------------------------
SDMBeginPort(C1)
' CSAT3 address
Const CSAT3_address = 2	'S/N:1255
' CSAT3 execution parameter
Const CSAT_OPT = INT(1000/SFREQ1)  'Denominator in mSec
' Default SDM clock speed
Const SDM_PER = 30

Public wind(5)

Alias wind(1) = Ux
Alias wind(2) = Uy
Alias wind(3) = Uz
Alias wind(4) = Ts
Alias wind(5) = diag_csat
Units wind = m/s
Units Ts = degC
Units diag_csat = unitless

' CSAT3 warning flags:
' 1) delta temperature, 2) poor signal lock,
' 3) amplitude high, or 4) amplitude low.
Public diag_bits(4) As Boolean
Units diag_bits = samples

Alias diag_bits(1) = delT_f
Alias diag_bits(2) = sigl_f
Alias diag_bits(3) = amph_f
Alias diag_bits(4) = ampl_f

' Diagnostic variables
Dim disable_flag_on(2) As Boolean
Dim n
Units n = samples

' Working variables
Dim diag_csat_work As Long

' LI-7500A --------------------------------------------------
Const LIC75_address = 0  'Licor #2, SDM: 12
  
Public LIC75(4) 'Licor output mode set equal to 6 !!!

Alias LIC75(1) = LI_CO2m  'CO2 [mmol/m3]
Alias LIC75(2) = LI_H2Om  'H2O [mmol/m3]
Alias LIC75(3) = LI_Pres  'Pressure [kPa]
Alias LIC75(4) = LI_diag  'Diagnostic value

Units LI_CO2m = mmol/m3
Units LI_H2Om = mmol/m3
Units LI_Pres = kPa
Units LI_diag = unitless  

Public diag_LI_bits(4) As Boolean
Units diag_LI_bits = samples
Alias diag_LI_bits(1) = li_chopper
Alias diag_LI_bits(2) = li_detector
Alias diag_LI_bits(3) = li_pll
Alias diag_LI_bits(4) = li_sync

Dim diag_licor_work As Long


' Other variables------------------------------------------

' Power and Time
Public BattV
Public PowerSPC
Public timer_PowerSPC_off, timer_PowerSPC_on
Public timer_PowerSPC_off_offset
Units BattV = V

Public LoggerTime(9) As Long
Alias LoggerTime(2) = month
Alias LoggerTime(9) = doy

' Modem----------------------------------------------------
Public MODEM_PWR_ON As Boolean = True

' GPS using the Serial Instruction------------------------- 

'GPS16X-HVS at Campbell Scientific Factory Defaults
Const GPSPort = ComRS232 'Com port where GPS is connected
Public GGAstring As String * 500
Public RMCstring As String * 500
Public rmcutc As String
Public rmclatitude As String
Public rmclongitude As String
Public rmcutcdate As String

Dim NBytesReturned As Long
Dim SubStrings(16) As String * 32, rawdata As String * 500
Dim CalculatedChecksum As Long, ReportedChecksum As Long

' Other Sensors--------------------------------------------

' SI-111 constants (FROM CALIBRATION SHEET!)
' S/N: SI-111-L-10_7289 (CS: 1072 ???????)
Const mC2 = 100573
Const mC1 = 8427070
Const mC0 = 1444790000
Const bC2 = 5075.53
Const bC1 = 91880.5
Const bC0 = -5055710

Public PTemp            'CR6
Public TRHData(2)		    'CS215
Alias TRHData(1) = TA   'CS215
Alias TRHData(2) = RH		'CS215
Public HSData_1min(2)		    'SR50A
Alias HSData_1min(1)=HS_Raw_1min	'SR50A
Alias HSData_1min(2)=HS_Qty_1min	'SR50A
Public HS_Cor_1min 			    'SR50A

Public HSData(11,2)		  'SR50A'
Public HSData_Raw(2)    'SR50A'
Alias HSData_Raw(1)=HS_Raw     : Units HS_Raw = meters	  'SR50A
Alias HSData_Raw(2)=HS_Qty_Raw : Units HS_Qty_Raw = unitless	'SR50A
Public Results_HSData(11,2)                           'SR50A'
Public HS_Cor       : Units HS_Cor       = meters 	  'SR50A'
Public HS_Qty       : Units HS_Qty       = unitless   'SR50A'
Public TRHData_Fast(2)         'T for SR50A correction'
Alias TRHData_Fast(1) = TAfast 'T for SR50A correction'
Public SR50ACtrl As Boolean

Public WS1			        'YOUNG1
Public WD1			        'YOUNG1
Public WS2			        'YOUNG2
Public WD2			        'YOUNG2
Public m,b 			        'SI-111
Public TargmV			      'SI-111
Public SFTempK		      'SI-111
Public SBTempC			    'SI-111
Public SBTempK			    'SI-111
Public SFTempC          'SI-111
Units PTemp = C	        'CR6
Units TA = C  		      'CS215
Units RH = %		        'CS215
Units HS_Cor_1min = m		    'SR50A
Units WS1 = m/s			    'YOUNG1
Units WD1 = deg			    'YOUNG1
Units WS2 = m/s			    'YOUNG2
Units WD2 = deg			    'YOUNG2

' =========================================================
' Define Data Tables
' =========================================================

' --- FAST DATA TABLE (10Hz CSAT3 + LI-7500A) ---
' v3.0: Single table with TableFile for automatic daily TOB3 files on card.
'       Replaces the 4x ZUGSPITZEfast01-04 tables + DOY Select Case logic.
'       TOB3 format (option 64) supports >2GB and is more efficient.
DataTable(ZUGSPITZEfast,True,-1)
  DataInterval(0,OFREQ1,mSec,10)
  'Create a new file every 24h on the card, TOB3 format, no file limit, auto-delete oldest
  TableFile("CRD:ZUGSPITZEfast",64,-1,0,24,hr,0,0)
  Sample(1,Ux,IEEE4)
  FieldNames("Ux: CSAT3 Ux [m/s]")
  Sample(1,Uy,IEEE4)
  FieldNames("Uy: CSAT3 Uy [m/s]")
  Sample(1,Uz,IEEE4)
  FieldNames("Uz: CSAT3 Uz [m/s]")
  Sample(1,Ts,IEEE4)
  FieldNames("Ts: Sonic Temp [degC]")
  Sample(1,LI_CO2m,IEEE4)
  FieldNames("LI_CO2m: CO2 density [mmol/m3]")
  Sample(1,LI_H2Om,IEEE4)
  FieldNames("LI_H2Om: H2O density [mmol/m3]")
  Sample(1,LI_Pres,IEEE4)
  FieldNames("LI_Pres: Air Pressure [kPa]")
  Sample(1,LI_diag,IEEE4)
  FieldNames("LI_diag: LI-7500A Diagnostic Flag")
EndTable

' --- 1-MINUTE METEO TABLE (all slow data consolidated) ---
' v3.0: Merged wind stats (from old ZUGSPITZEwind) and median snow height
'       (from old ZUGSPITZE1Min_HS) into this single table.
DataTable(ZUGSPITZE1Min,True,-1)
  DataInterval(0,OFREQ2,Sec,0)
  CardOut(1,nRec2)

  ' --- GPS ---
  Sample(1,rmcutc,String)
  Sample(1,rmclatitude,String)
  Sample(1,rmclongitude,String)
  Sample(1,rmcutcdate,String)

  ' --- Logger diagnostics ---
  Minimum(1,BattV,FP2,False,False)
  FieldNames("BattV_Min: minimum battery voltage [V]")
  Average(1,PTemp,FP2,False)
  FieldNames("PTemp_Avg: panel temperature [C]")
  Sample(1,PowerSPC,Long,False)
  FieldNames("PowerSPC: SPC power state")

  ' --- Young wind monitors (1-min statistics) ---
  ' (Previously in separate ZUGSPITZEwind table)
  Average(1,WS1,FP2,False)
  FieldNames("WS1_Avg: Young1 mean wind speed [m/s]")
  Maximum(1,WS1,FP2,False,False)
  FieldNames("WS1_Max: Young1 gust [m/s]")
  StdDev(1,WS1,FP2,False)
  FieldNames("WS1_Std: Young1 wind speed std [m/s]")
  Sample(1,WD1,FP2)
  FieldNames("WD1: Young1 wind direction [deg]")
  Average(1,WS2,FP2,False)
  FieldNames("WS2_Avg: Young2 mean wind speed [m/s]")
  Maximum(1,WS2,FP2,False,False)
  FieldNames("WS2_Max: Young2 gust [m/s]")
  StdDev(1,WS2,FP2,False)
  FieldNames("WS2_Std: Young2 wind speed std [m/s]")
  Sample(1,WD2,FP2)
  FieldNames("WD2: Young2 wind direction [deg]")

  ' --- CSAT3 sonic 1-min statistics ---
  Average(4,Ux,IEEE4,False)
  FieldNames("Ux_Avg: CSAT3 Ux avg [m/s],Uy_Avg: CSAT3 Uy avg [m/s],Uz_Avg: CSAT3 Uz avg [m/s],Ts_Avg: Sonic temp avg [degC]")
  StdDev(4,Ux,IEEE4,False)
  FieldNames("Ux_Std: CSAT3 Ux std [m/s],Uy_Std: CSAT3 Uy std [m/s],Uz_Std: CSAT3 Uz std [m/s],Ts_Std: Sonic temp std [degC]")

  ' --- Temperature / Humidity ---
  Sample(1,TA,FP2)
  FieldNames("TA: CS215 air temperature [C]")
  Sample(1,RH,FP2)
  FieldNames("RH: CS215 relative humidity [%]")

  ' --- Snow height (1-min from SlowSequence 1) ---
  Sample(1,HS_Cor_1min,FP2)
  FieldNames("HS_Cor_1min: SR50A corrected distance 1min [m]")
  Sample(1,HS_Qty_1min,FP2)
  FieldNames("HS_Qty_1min: SR50A signal quality 1min")

  ' --- Snow height (median-filtered from SlowSequence 2) ---
  ' (Previously in separate ZUGSPITZE1Min_HS table)
  Sample(1,HS_Cor,FP2)
  FieldNames("HS_Cor: SR50A median corrected distance [m]")
  Sample(1,HS_Qty,FP2)
  FieldNames("HS_Qty: SR50A median signal quality")

  ' --- Surface temperature (SI-111) ---
  Sample(1,SBTempC,IEEE4)
  FieldNames("SBTempC: SI-111 sensor body temp [C]")
  Sample(1,SFTempC,IEEE4)
  FieldNames("SFTempC: SI-111 surface temp [C]")

  ' --- LI-7500A 1-min statistics ---
  Average(4,LI_CO2m,IEEE4,0)
  FieldNames("LI_CO2m_Avg: CO2 avg [mmol/m3],LI_H2Om_Avg: H2O avg [mmol/m3],LI_Pres_Avg: Pres avg [kPa],LI_diag_Avg: diag avg")
  StdDev(4,LI_CO2m,IEEE4,0)
  FieldNames("LI_CO2m_Std: CO2 std [mmol/m3],LI_H2Om_Std: H2O std [mmol/m3],LI_Pres_Std: Pres std [kPa],LI_diag_Std: diag std")

  ' --- CSAT3 diagnostic totals ---
  Average(4,Ux,IEEE4,disable_flag_on(1))
  FieldNames("Ux_Avg_filt,Uy_Avg_filt,Uz_Avg_filt,Ts_Avg_filt")
  StdDev(4,Ux,IEEE4,disable_flag_on(1))
  FieldNames("Ux_Std_filt,Uy_Std_filt,Uz_Std_filt,Ts_Std_filt")
  Totalize(1,n,IEEE4,disable_flag_on(1))
  FieldNames("csat_good_samples")
  Totalize(1,n,IEEE4,NOT(disable_flag_on(1) OR disable_flag_on(2)))
  FieldNames("csat_warnings")
  Totalize(1,n,IEEE4,NOT(delT_f) OR NOT disable_flag_on(2))
  FieldNames("delT_f_Tot")
  Totalize(1,n,IEEE4,NOT(sigl_f) OR NOT disable_flag_on(2))
  FieldNames("sigl_f_Tot")
  Totalize(1,n,IEEE4,NOT(amph_f) OR NOT disable_flag_on(2))
  FieldNames("amph_f_Tot")
  Totalize(1,n,IEEE4,NOT(ampl_f) OR NOT disable_flag_on(2))
  FieldNames("ampl_f_Tot")

  ' --- LI-7500A diagnostic totals ---
  Totalize(1,n,IEEE4,li_chopper)
  FieldNames("li_chopper")
  Totalize(1,n,IEEE4,li_detector)
  FieldNames("li_detector")
  Totalize(1,n,IEEE4,li_pll)
  FieldNames("li_pll")
  Totalize(1,n,IEEE4,li_sync)
  FieldNames("li_sync")
EndTable


' MEASUREMENTS=============================================

' Main Program

BeginProg
  timer_PowerSPC_off_offset = 43200   'in [sec] = 12h       
  'This offset ensures that the SPC will be switched on when the logger starts. 
  'Should just be large, in any case larger than  ??

  'Open serial port for GPS
  SerialOpen(GPSPort,38400,3,0,1001)

  'Set all CSAT3 variables to NaN.
  Move(Ux,5,NaN,1)

  'Set the SDM clock speed.
  SDMSpeed(SDM_PER)

  n = 0

  'Main Scan+++++++++++++++++++++++++++++++++++++++++++++++
  
  Scan(SFREQ1,mSec,5,0)
    
      SDMTrigger()
    
      '***Measure CSAT3 and LI7500-------------------------
          
      'Get data from CSAT3, 98: Get wind & sonic temperature data after a group trigger 
      ' CSAT_OPT: 10Hz execution parameter
      CSAT3(Ux,1,CSAT3_address,98,CSAT_OPT)
      'Get data from LI7500
      CS7500(LI_CO2m,1,LIC75_address,6)
      
      'CSAT3 processing------------------------------------
      'Define 61502 as NaN
      If (diag_csat = NaN) Then 
        (diag_csat = 61502)
        Ux = NaN
        Uy = NaN
        Uz = NaN
        Ts = NaN
      EndIf  
        'Break up the 4 CSAT3 warning flags in 4 separate bits
        diag_csat_work = diag_csat
        delT_f = diag_csat_work AND &h8000
        sigl_f = diag_csat_work AND &h4000
        amph_f = diag_csat_work AND &h2000
        ampl_f = diag_csat_work AND &h1000
  
        'Turn on the intermediate processing disable flag when any CSAT3 warning flag is
        'high, including the special cases NaN (61502), a Lost Trigger (61440), No Data
        '(61503), an SDM error (61441), or wrong CSAT3 embedded code (61442).
        disable_flag_on(1) = diag_csat_work AND &hf000
        'Turn on only when CSAT3 diagnostic warning flags are set.
        disable_flag_on(2) = (disable_flag_on(1) AND NOT (Ts=NaN))

        'Save the four most significant bits of the CSAT3 diagnostics, except for the
        'special cases NaN (61502), a Lost Trigger (61440), No Data (61503), an SDM
        'error (61441), or wrong CSAT3 embedded code (61442).
        If (diag_csat_work<&hf000) Then 
          diag_csat = INT(diag_csat_work/&h1000)
        EndIf

      'Licor diag -----------------------------------------------
      diag_licor_work = LI_diag
      li_chopper = diag_licor_work AND &h80
      li_detector = diag_licor_work AND &h40
      li_pll = diag_licor_work AND &h20
      li_sync = diag_licor_work AND &h10

      ' v3.0: Single fast table call replaces the DOY-based Select Case
      CallTable ZUGSPITZEfast

    '*** Measure wind speed as a mean of the last second (1000ms)
    '--- rd=P_LLAC, bk=WS_gnd, gn=WD_Sig, bl=WD_Ex, gy/wh=WD_gnd, cl=shld
    PulseCount(WS1,1,U12,5,1000,0.1666,0)	' Young 1
    PulseCount(WS2,1,U2 ,5,1000,0.1666,0)	' Young 2
    'PulseCount instruction not allowed in SlowSequence
    
  NextScan

  '++++++++++++++++++++++++++++++++++++++++++++++++++++++++
  SlowSequence
  
  SW12(SW12_2,0) 'switch modem on at beginning, solidstate relay normally closed
  MODEM_PWR_ON = True

  Scan (SFREQ2,Sec,3,0)

    'Get logger time
    RealTime(LoggerTime)
    
    '*** Measure the Datalogger Battery Voltage
    Battery(BattV)
    
    '*** Modem reset every week
    If (LoggerTime(8) = 2 AND TimeIsBetween(650,656,1440,min)) Then
      If MODEM_PWR_ON = True
        MODEM_PWR_ON = False
        SW12(SW12_2,1) 'switch modem off solidstate relay normally closed
      EndIf
    ElseIf MODEM_PWR_ON = False
      MODEM_PWR_ON = True
      SW12(SW12_2,0) 'switch modem on, solidstate relay normally closed
    EndIf  

    '*** Measure the Datalogger Wiring Panel Temperature
    PanelTemp(PTemp,60)
    
    'Voltage regulations
    ' STAGE 1: SPC-----------------------------------------
    ' If BattV drops below LowVoltSPC, switch off SPC
    If(BattV < LowVoltSPC) Then
      SW12(1,0)
      PowerSPC = 0
      timer_PowerSPC_off = Timer(1,min,2)  'Reset and start timer_PowerSPC_on
      timer_PowerSPC_off_offset = 0
      timer_PowerSPC_on = 0
    EndIf
    If(timer_PowerSPC_on > SPC_Forced_Restart) Then
    ' Switch off to trigger a forced restart
      SW12(1,0)
      PowerSPC = 0
      timer_PowerSPC_off = Timer(1,min,2)  'Reset and start timer_PowerSPC_off
      timer_PowerSPC_off_offset = SPC_LowPowerOff-SPC_Forced_Restart_Time
      timer_PowerSPC_on = 0
    EndIf
    'If BattV is above LowVoltSPC + 0.2V, switch SPC on
    If((BattV > LowVoltSPC + 0.2) AND (PowerSPC = 0) AND (timer_PowerSPC_off > SPC_LowPowerOff)) Then
      SW12(1,1)
      PowerSPC = 1
      timer_PowerSPC_on = Timer(2,min,2)  'Reset and start timer_PowerSPC_on
      timer_PowerSPC_off = 0
      timer_PowerSPC_off_offset = 0
    EndIf

    If(PowerSPC = 0) Then
      timer_PowerSPC_off = timer_PowerSPC_off_offset + Timer(1,min,4) ' Query timer PowerSPC_off
    Else
      timer_PowerSPC_on = Timer(2,min,4)                              ' Query timer PowerSPC_on
    EndIf    

    '*** Measure the YOUNG1 (WD only)
    '--- Dest, Reps, Range, SEChan, ExChan, MeasPEx, ExmV, RevEx, Settlingtime, fN1, Mult, Offset
    '--- rd=P_LLAC, bk=WS_gnd, gn=WD_Sig, bl=WD_Ex, gy/wh=WD_gnd, cl=shld
    BrHalf(WD1,1,mV5000,U3,U5,1,2500,True,20000,60,355,0)
    If WD1>=360 Then WD1=0
    If WD1<0 Then WD1=0

    '*** Measure the YOUNG2 (WD only)
    '--- Dest, Reps, Range, SEChan, ExChan, MeasPEx, ExmV, RevEx, Settlingtime, fN1, Mult, Offset
    '--- rd=P_LLAC, bk=WS_gnd, gn=WD_Sig, bl=WD_Ex, gy/wh=WD_gnd, cl=shld
    BrHalf(WD2,1,mV5000,U4,U5,1,2500,True,20000,60,355,0)
    If WD2>=360 Then WD2=0
    If WD2<0 Then WD2=0

    '*** Measure the SI-111
    '--- Dest, Reps, SEChan, ExChan, SettlingTime, fN1, Mult, Offset
    '--- rd=TC_H, bk=TC_L, cl=G, gn=SBT_Sig, bl=SBT_gnd, wh=SBT_Ex
    '*** Measurement of sensor body temperature with inbuilt thermistor
    Therm109(SBTempC,1,U6,U5,0,_60Hz,1,0)
    '--- Dest, Reps, Range, DiffChan, RevDiff, SettlingTime, fN1, Mult, Offset
    '*** Measurement thermopile detector (rd = Sig+ = U(hi), vt = Sig- = U(low))
    VoltDiff(TargmV,1,mV200,U7,True,0,_60Hz,1,0)
    'Calculation of m (slope) and b (intercept) coeffs for target temp calculation
    m = mC2 * SBTempC^2 + mC1 * SBTempC + mC0
    b = bC2 * SBTempC^2 + bC1 * SBTempC + bC0
    'Calculation of target temperature
    SBTempK = SBTempC + 273.15
    SFTempK = ((SBTempK^4) + m * TargmV + b)^0.25
    SFTempC = SFTempK - 273.15

    '*** Measure the CS215 (SDM address: 0)
    '--- Dest, SDIPort, SDIAddress, SDICommand, Mult, Offset
    '--- rd=12V, wh=G, bk=G, gn=SDI-12(odd), cl=shld
    SDI12Recorder(TRHData(),U9,"0","M!",1,0) 
    'See CS215 manual Appendix D.2.5, Change Address Command (aAb!) (p.D-3), 
    'to change the CS215 SDI-12 address from its default address of 0
    
        '*** Measure the SR50A (SDM address: 1)
    '--- Dest, SDIPort, SDIAddress, SDICommand, Mult, Offset
    '--- rd=12V, bk=G, gn=SDI-12(odd), wh=G, cl=G
    'Use SDI-12 command "M1!" to receive Distance and Signal quality from the SR50A
    SDI12Recorder(HSData_1min(),U9,"1","M1!",1,0) 
    'Use TA to calculate corrected distance:
    HS_Cor_1min=HS_Raw_1min*(SQR((TA+273.15)/273.15))
    
   '*** Measure the GPS using the Serial instruction
    '--- rd=12V, wh(RX)=RS-232, bl(TX)=RS-232, bk/ye/bl=G
     SerialInRecord (GPSPort,rawdata,36,0,&h0D0A,NBytesReturned,11)
     CalculatedChecksum = CheckSum (rawdata,9,Len(rawdata) - 3)
     CalculatedChecksum = CalculatedChecksum AND 255
     ReportedChecksum = HexToDec(Right(rawdata,2))
     If CalculatedChecksum = ReportedChecksum Then
       If InStr (1,rawdata,"GPRMC",2) Then
         RMCstring = rawdata
       ElseIf InStr (1,rawdata,"GPGGA",2) Then
         GGAstring = rawdata
       EndIf
     EndIf
     
     SerialInRecord (GPSPort,rawdata,36,0,&h0D0A,NBytesReturned,11)
     CalculatedChecksum = CheckSum (rawdata,9,Len(rawdata) - 3)
     CalculatedChecksum = CalculatedChecksum AND 255
     ReportedChecksum = HexToDec(Right(rawdata,2))
     If CalculatedChecksum = ReportedChecksum Then
       If InStr (1,rawdata,"GPRMC",2) Then
         RMCstring = rawdata
       ElseIf InStr (1,rawdata,"GPGGA",2) Then
         GGAstring = rawdata
       EndIf
     EndIf

     'parse rmc data
     SplitStr (SubStrings(),RMCstring,",",16,5)
     rmcutc = SubStrings(2)
     rmclatitude = SubStrings(4)
     rmclongitude = SubStrings(6)
     rmcutcdate = SubStrings(10)

  ' v3.0: Single CallTable replaces the old ZUGSPITZE1Min + ZUGSPITZEwind
  CallTable ZUGSPITZE1Min

  NextScan

  EndSequence
  
  SlowSequence
  
      n = 1
      Scan (4,sec,3,0)
        If TimeIntoInterval(4, 60, Sec) Then
          SR50ACtrl = True
        EndIf

        If SR50ACtrl Then
          SDI12Recorder(HSData_Raw(),U9,"1","M1!",1,0) 
          SDI12Recorder(TRHData_Fast(),U9,"0","M!",1,0) 
          'Use TA to calculate corrected distance:
          HSData(n,1)=HSData_Raw(1)*(SQR((TAfast+273.15)/273.15))
          HSData(n,2)=HSData_Raw(2)        
          n += 1
        

          If n > 11 Then
            n = 1
            SR50ACtrl = False
            SortSpa (Results_HSData(1,1),11,HSData(1,1),2)
            HS_Cor = Results_HSData(6,1)
            HS_Qty = Results_HSData(6,2)
            
          EndIf
        EndIf
      ' v3.0: No separate CallTable here; HS_Cor and HS_Qty are picked up
      '        by the main ZUGSPITZE1Min table via Sample()
      NextScan
  
  EndSequence
  
EndProg
